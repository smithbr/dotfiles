# Install all dependencies with: brew bundle
# Usage: brew bundle [--file=Brewfile.core]

# Core Tools
brew "bats-core"
brew "bottom"
brew "difftastic"
brew "domain-check"
brew "fresh-editor"
brew "fzf"
brew "gh"
brew "ghq"
brew "git-delta"
brew "git-lfs"
brew "glances"
brew "go"
brew "jq"
brew "lazygit"
brew "llmfit"
brew "markdownlint-cli2"
brew "node"
brew "nvm"
brew "pnpm"
brew "restic"
brew "ripgrep"
brew "shellcheck"
brew "skills"
brew "stow"
brew "uv"
brew "xdg-ninja"
cask "1password-cli"

# Shell Enhancements
brew "antidote"
brew "asciiquarium"
brew "bat"
brew "fastfetch"
brew "glow"
brew "gum"
brew "nerdfetch"
brew "onefetch"
brew "starship"

# Fonts
cask "font-0xproto-nerd-font"
cask "font-caskaydia-cove-nerd-font"
cask "font-fantasque-sans-mono-nerd-font"
cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"
cask "font-iosevka-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-meslo-lg-nerd-font"
cask "font-mononoki-nerd-font"
cask "font-sauce-code-pro-nerd-font"
