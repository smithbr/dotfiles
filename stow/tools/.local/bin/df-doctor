#!/usr/bin/env bash
# Check this machine against the dotfiles repo and offer fixes; every argument
# goes to scripts/doctor.sh as it is.

set -euo pipefail

# The script lives at <repo>/stow/tools/.local/bin/df-doctor, reached through its stow link.
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../.." && pwd)"
if [[ ! -f "${repo}/scripts/doctor.sh" ]]; then
    printf 'df-doctor: cannot find scripts/doctor.sh in %s\n' "${repo}" >&2
    exit 1
fi
exec bash "${repo}/scripts/doctor.sh" "$@"
