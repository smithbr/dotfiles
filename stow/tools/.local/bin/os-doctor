#!/usr/bin/env bash

set -euo pipefail

# Shared helpers from the dotfiles repo, reached through this script's stow
# link; DOTFILES_DIR names the repo when a copy runs from elsewhere.
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../.." && pwd)}"
# shellcheck source=scripts/common.sh
source "${DOTFILES_DIR}/scripts/common.sh"

APT_GET_BIN="${APT_GET_BIN:-apt-get}"
BREW_BIN="${BREW_BIN:-brew}"
SOFTWAREUPDATE_BIN="${SOFTWAREUPDATE_BIN:-softwareupdate}"
MAS_BIN="${MAS_BIN:-mas}"
XCODEBUILD_BIN="${XCODEBUILD_BIN:-xcodebuild}"
XCODE_APP_PATH="${XCODE_APP_PATH:-/Applications/Xcode.app}"
ZSH_BIN="${ZSH_BIN:-zsh}"
UV_BIN="${UV_BIN:-uv}"
NPM_BIN="${NPM_BIN:-npm}"
# Empty means Homebrew's antidote, found through `brew --prefix`.
ANTIDOTE_ZSH="${ANTIDOTE_ZSH:-}"

usage() {
    local help_text

    help_text="$(cat <<'EOF'
# os-doctor

Run operating system and package-manager updates for this machine.

## Steps

- `Linux`: run `apt-get update`, `full-upgrade`, `autoremove`, and `autoclean` when available
- `macOS`: run `softwareupdate --install --all` when available
- `App Store`: run `mas upgrade` when updates are available
- `Xcode`: accept the license if a newly updated install requires it
- `Homebrew`: run `brew update`, `upgrade --fetch-HEAD` (so formulae installed from HEAD, such as xdg-ninja, update too), `autoremove` (dependencies nothing needs any more), install any missing dependency `brew missing` reports, `cleanup`, and clear the brew cache
- `Tool caches`: `uv cache prune` (drops unused uv cache entries) and `npm cache verify` (garbage-collects the cache `npx` fills) when installed
- `zsh plugins`: run `antidote update` when antidote is installed (its own version comes from Homebrew)

## Examples

- `os-doctor`: run the full update flow for the current platform
EOF
)"

    if [[ "${HAS_GUM}" == true ]]; then
        printf '%s\n' "${help_text}" | gum format
        return
    fi

    cat <<'EOF'
Usage:
  os-doctor
  os-doctor --help

Run operating system and package-manager updates for this machine.
EOF
}

append_path_dir() {
    local dir="${1}"

    if [[ -n "${dir}" && -d "${dir}" && ":${PATH}:" != *":${dir}:"* ]]; then
        PATH="${dir}:${PATH}"
    fi
}

has_command() {
    local cmd="${1}"

    command -v "${cmd}" >/dev/null 2>&1
}

ensure_brew_in_path() {
    if has_command "${BREW_BIN}"; then
        return
    fi

    case "${OSTYPE}" in
        darwin*)
            case "$(uname -m)" in
                arm64)
                    append_path_dir "/opt/homebrew/bin"
                    append_path_dir "/opt/homebrew/sbin"
                    ;;
                *)
                    append_path_dir "/usr/local/bin"
                    append_path_dir "/usr/local/sbin"
                    ;;
            esac
            ;;
        linux*)
            append_path_dir "/home/linuxbrew/.linuxbrew/bin"
            append_path_dir "/home/linuxbrew/.linuxbrew/sbin"
            ;;
    esac
}

platform_label() {
    case "${OSTYPE}" in
        darwin*) printf 'macOS\n' ;;
        linux*) printf 'Linux\n' ;;
        *) printf 'unknown\n' ;;
    esac
}

print_intro() {
    local section=""

    _header "os-doctor"
    section+="Platform: $(platform_label)"
    section+=$'\n'"apt-get: ${APT_GET_BIN}"
    section+=$'\n'"brew: ${BREW_BIN}"

    case "${OSTYPE}" in
        darwin*)
            section+=$'\n'"softwareupdate: ${SOFTWAREUPDATE_BIN}"
            section+=$'\n'"mas: ${MAS_BIN}"
            section+=$'\n'"xcodebuild: ${XCODEBUILD_BIN}"
            ;;
    esac

    _box "${section}"
}

run_brew_updates() {
    local brew_cache=""
    local section=""

    printf '\n'
    _header "Homebrew"

    ensure_brew_in_path

    if ! has_command "${BREW_BIN}"; then
        section+="Warning: Homebrew not found; skipping Homebrew updates"
        add_result "WARN" "Homebrew not found; skipping Homebrew updates"
        _box "${section}"
        return 0
    fi

    _item "Running brew update"
    _item "Running brew upgrade --fetch-HEAD"
    _item "Running brew autoremove"
    _item "Running brew cleanup --prune=all"

    "${BREW_BIN}" update
    # A formula installed from HEAD (Brewfile args: ["HEAD"]) is otherwise only
    # rebuilt when a new release comes out, and stays on its old commit.
    "${BREW_BIN}" upgrade --fetch-HEAD
    "${BREW_BIN}" autoremove
    install_missing_brew_deps
    "${BREW_BIN}" cleanup --prune=all

    brew_cache="$("${BREW_BIN}" --cache)"
    clear_brew_cache "${brew_cache}"

    add_result "PASS" "Homebrew updates completed"
}

# `brew missing` prints "formula: dep dep" for each installed formula whose
# dependencies are gone, and exits 1 when it finds any.
install_missing_brew_deps() {
    local missing=""
    local -a deps=()

    missing="$("${BREW_BIN}" missing 2>/dev/null)" || true
    [[ -n "${missing}" ]] || return 0
    read -r -a deps <<< "$(printf '%s\n' "${missing}" | awk -F': ' 'NF > 1 { print $2 }' | tr '\n' ' ')"
    (( ${#deps[@]} > 0 )) || return 0

    _item "Installing missing Homebrew dependencies: ${deps[*]}"
    "${BREW_BIN}" install "${deps[@]}"
}

# Package-manager caches that grow without bound. Both commands only drop
# what nothing uses, so the next `uvx` or `npx` run does not refetch everything.
run_tool_cache_cleanup() {
    local section=""

    printf '\n'
    _header "Tool caches"

    if has_command "${UV_BIN}"; then
        _item "Running uv cache prune"
        # A running uvx (an MCP server, say) holds the cache lock; skip rather
        # than wait the default five minutes or fail the whole update.
        if UV_LOCK_TIMEOUT=10 "${UV_BIN}" cache prune; then
            section+="uv cache pruned"$'\n'
        else
            section+="Warning: uv cache is in use; prune skipped"$'\n'
            add_result "WARN" "uv cache in use; run uv cache prune later"
        fi
    fi
    if has_command "${NPM_BIN}"; then
        _item "Running npm cache verify"
        "${NPM_BIN}" cache verify
        section+="npm cache verified"$'\n'
    fi

    _box "${section:-uv and npm not installed; nothing to prune}"
    add_result "PASS" "Tool caches cleaned"
}

# antidote is a zsh function: load it in a bare zsh with the .zshrc's
# ANTIDOTE_HOME. The static bundle needs no rebuild.
run_antidote_updates() {
    local antidote_zsh="${ANTIDOTE_ZSH}"
    local brew_prefix=""

    printf '\n'
    _header "zsh plugins"

    if [[ -z "${antidote_zsh}" ]] && has_command "${BREW_BIN}"; then
        brew_prefix="$("${BREW_BIN}" --prefix 2>/dev/null)" || brew_prefix=""
        [[ -n "${brew_prefix}" ]] && antidote_zsh="${brew_prefix}/opt/antidote/share/antidote/antidote.zsh"
    fi

    if [[ -z "${antidote_zsh}" || ! -f "${antidote_zsh}" ]]; then
        _box "antidote not installed; skipping zsh plugin updates"
        add_result "PASS" "antidote not installed; skipping zsh plugin updates"
        return 0
    fi

    if ! has_command "${ZSH_BIN}"; then
        _box "Warning: zsh not found; skipping zsh plugin updates"
        add_result "WARN" "zsh not found; skipping zsh plugin updates"
        return 0
    fi

    _item "Running antidote update"
    # shellcheck disable=SC2016 # expanded by zsh, not here
    ANTIDOTE_HOME="${ANTIDOTE_HOME:-${XDG_CACHE_HOME:-${HOME}/.cache}/antidote}" \
        "${ZSH_BIN}" -fc 'source "$1" && antidote update' zsh "${antidote_zsh}"
    add_result "PASS" "zsh plugin updates completed"
}

# `brew --cache` honors HOMEBREW_CACHE, so refuse anything that is not plainly
# a Homebrew cache directory before deleting it.
clear_brew_cache() {
    local brew_cache="${1}"
    local resolved=""
    local home_dir="${HOME%/}"
    local home_real=""

    # Nothing to delete; an already-missing cache is not a problem.
    if [[ -n "${brew_cache}" && ! -e "${brew_cache}" && ! -L "${brew_cache}" ]]; then
        return 0
    fi

    if [[ -n "${brew_cache}" && -d "${brew_cache}" ]]; then
        resolved="$(cd -P "${brew_cache}" 2>/dev/null && pwd)" || resolved=""
    fi
    home_real="$(cd -P "${HOME:-/}" 2>/dev/null && pwd)" || home_real="/"

    case "${resolved}" in
        ""|/|"${home_dir}"|"${home_real}")
            ;;
        */Homebrew|*/Homebrew/*)
            rm -rf "${resolved}"
            return 0
            ;;
    esac

    _warn "Warning: not clearing unexpected Homebrew cache path: ${brew_cache:-<empty>}"
    add_result "WARN" "Skipped clearing unexpected Homebrew cache path: ${brew_cache:-<empty>}"
}

run_linux_updates() {
    local section=""

    printf '\n'
    _header "Linux"

    if ! has_command "${APT_GET_BIN}"; then
        section+="Warning: apt-get not found; skipping apt updates"
        _box "${section}"
        add_result "WARN" "apt-get not found; skipping apt updates"
        run_brew_updates
        return 0
    fi

    _item "Running apt-get update"
    _item "Running apt-get full-upgrade -y"
    _item "Running apt-get autoremove --purge -y"
    _item "Running apt-get autoclean -y"

    sudo_cmd "${APT_GET_BIN}" update
    sudo_cmd "${APT_GET_BIN}" full-upgrade -y
    sudo_cmd "${APT_GET_BIN}" autoremove --purge -y
    sudo_cmd "${APT_GET_BIN}" autoclean -y

    add_result "PASS" "Linux package updates completed"
    run_brew_updates
}

run_app_store_updates() {
    local outdated_output=""
    local section=""

    printf '\n'
    _header "App Store"
    _item "Running mas outdated"

    if ! has_command "${MAS_BIN}"; then
        section+="Warning: mas not found; skipping App Store updates"
        _box "${section}"
        add_result "WARN" "mas not found; skipping App Store updates"
        return 0
    fi

    if ! outdated_output="$("${MAS_BIN}" outdated 2>&1)"; then
        section+="Warning: mas could not check App Store updates; skipping"
        _box "${section}"
        add_result "WARN" "mas could not check App Store updates; skipping"
        return 0
    fi

    if [[ -z "${outdated_output}" ]]; then
        section+="No App Store updates available"
        _box "${section}"
        add_result "PASS" "No App Store updates available"
        return 0
    fi

    _item "Running mas upgrade"
    "${MAS_BIN}" upgrade
    add_result "PASS" "App Store updates completed"
}

accept_xcode_license_if_needed() {
    local section=""

    printf '\n'
    _header "Xcode"

    if [[ ! -d "${XCODE_APP_PATH}" ]]; then
        _item "Checking for Xcode at ${XCODE_APP_PATH}"
        section+="Xcode app not found; skipping license check"
        _box "${section}"
        add_result "PASS" "Xcode app not found; skipping license check"
        return 0
    fi

    if ! has_command "${XCODEBUILD_BIN}"; then
        _item "Checking for ${XCODEBUILD_BIN}"
        section+="Warning: xcodebuild not found; skipping Xcode license check"
        _box "${section}"
        add_result "WARN" "xcodebuild not found; skipping Xcode license check"
        return 0
    fi

    _item "Running ${XCODEBUILD_BIN} -license check"
    if ! "${XCODEBUILD_BIN}" -license check >/dev/null 2>&1; then
        _item "Accepting Xcode license"
        sudo_cmd "${XCODEBUILD_BIN}" -license accept
        add_result "PASS" "Accepted Xcode license"
        return 0
    fi

    section+="Xcode license already accepted"
    _box "${section}"
    add_result "PASS" "Xcode license already accepted"
}

run_macos_updates() {
    local section=""

    printf '\n'
    _header "macOS"

    if has_command "${SOFTWAREUPDATE_BIN}"; then
        _item "Running softwareupdate --install --all"
        sudo_cmd "${SOFTWAREUPDATE_BIN}" --install --all
        add_result "PASS" "macOS software updates completed"
    else
        section+="Warning: softwareupdate not found; skipping macOS software updates"
        _box "${section}"
        add_result "WARN" "softwareupdate not found; skipping macOS software updates"
    fi

    run_app_store_updates
    accept_xcode_license_if_needed
    run_brew_updates
}

print_summary() {
    local entry=""
    local kind=""
    local message=""
    local summary_body=""
    local step=""
    local steps_body=""

    printf '\n'
    _header "Summary"

    summary_body="passed: ${PASS_COUNT}"$'\n'"warnings: ${WARN_COUNT}"$'\n'"failed: ${FAIL_COUNT}"
    for entry in "${SUMMARY_RESULTS[@]}"; do
        kind="${entry%%$'\t'*}"
        message="${entry#*$'\t'}"
        summary_body+=$'\n'
        summary_body+="${kind}  ${message}"
    done

    _box "${summary_body}"
    printf '\n'

    if [[ "${FAIL_COUNT}" -eq 0 && "${WARN_COUNT}" -eq 0 ]]; then
        if [[ "${HAS_GUM}" == true ]]; then
            gum style --foreground 76 --bold "Passed: ${PASS_COUNT}  Warnings: ${WARN_COUNT}  Failed: ${FAIL_COUNT}"
            gum style --foreground 76 --bold "OS update run completed."
        else
            printf 'Passed: %s  Warnings: %s  Failed: %s\n' "${PASS_COUNT}" "${WARN_COUNT}" "${FAIL_COUNT}"
            printf 'OS update run completed.\n'
        fi
        return 0
    fi

    if [[ "${HAS_GUM}" == true ]]; then
        gum style --foreground 76 --bold "Passed: ${PASS_COUNT}"
        gum style --foreground 214 --bold "Warnings: ${WARN_COUNT}"
        gum style --foreground 196 --bold "Failed: ${FAIL_COUNT}"
        gum style --foreground 214 --bold "Completed with ${WARN_COUNT} warning(s) and ${FAIL_COUNT} failing check(s)."
    else
        printf 'Passed: %s  Warnings: %s  Failed: %s\n' "${PASS_COUNT}" "${WARN_COUNT}" "${FAIL_COUNT}"
        printf 'Completed with %s warning(s) and %s failing check(s).\n' "${WARN_COUNT}" "${FAIL_COUNT}" >&2
    fi

    for step in "${NEXT_STEPS[@]+"${NEXT_STEPS[@]}"}"; do
        steps_body+="- ${step}"$'\n'
    done

    if [[ -n "${steps_body}" ]]; then
        printf '\n'
        _header "Next Steps"
        _box "${steps_body%$'\n'}"
    fi

    [[ "${FAIL_COUNT}" -eq 0 ]]
}

parse_args() {
    case "${1:-}" in
        "")
            ;;
        -h|-help|--help|help)
            usage
            exit 0
            ;;
        *)
            die "Unknown argument: ${1}"
            ;;
    esac
}

main() {
    parse_args "$@"
    require_non_root
    print_intro

    case "${OSTYPE}" in
        darwin*)
            run_macos_updates
            ;;
        linux*)
            run_linux_updates
            ;;
        *)
            add_result "FAIL" "Unsupported OS: ${OSTYPE}"
            add_next_step "Run os-doctor on macOS or Linux"
            printf '\n'
            _header "Platform"
            _box "FAIL  Unsupported OS: ${OSTYPE}"$'\n'"Fix: Run os-doctor on macOS or Linux"
            print_summary
            exit 1
            ;;
    esac

    run_antidote_updates
    run_tool_cache_cleanup
    print_summary
}

main "$@"
