# Mac desktop git settings: VS Code as editor, keychain credentials, and commit
# signing through the 1Password SSH agent. Included by ~/.config/git/config.

[credential]
    helper = osxkeychain
[core]
    editor = code
[diff]
    tool = code
[merge]
    tool = code
[user]
    signingkey = ~/.ssh/id_ed25519.pub
[commit]
    gpgsign = true
[gpg]
    format = ssh
[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
