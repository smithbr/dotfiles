# lazygit: change directory on exit
lg() {
    export LAZYGIT_NEW_DIR_FILE=~/.lazygit/newdir

    lazygit "$@"

    if [[ -f "${LAZYGIT_NEW_DIR_FILE}" ]]; then
        cd "$(cat "${LAZYGIT_NEW_DIR_FILE}")"
        rm -f "${LAZYGIT_NEW_DIR_FILE}" > /dev/null
    fi
}

# new alias: save to the dotfiles repo and define it now
#   na hg 'history 1 | grep '
na() {
    if [[ $# -ne 2 || -z "$1" ]]; then
        echo "usage: na NAME 'COMMAND'" >&2
        return 2
    fi
    local name="$1" value="$2"
    local file="${DOTFILES_DIR:-${HOME}/.dotfiles}/stow/common/.config/shell/aliases"

    if [[ ! "${name}" =~ ^[A-Za-z0-9_.-]+$ ]]; then
        echo "na: invalid alias name: ${name}" >&2
        return 2
    fi
    if [[ ! -f "${file}" ]]; then
        echo "na: missing ${file}" >&2
        return 1
    fi
    if grep -q "^[[:space:]]*alias ${name}=" "${file}"; then
        echo "na: ${name} already exists in ${file}" >&2
        return 1
    fi

    # keep $, `, " and \ literal so they evaluate when the alias runs
    local escaped="${value//\\/\\\\}"
    escaped="${escaped//\"/\\\"}"
    escaped="${escaped//\$/\\\$}"
    escaped="${escaped//\`/\\\`}"

    printf 'alias %s="%s"\n' "${name}" "${escaped}" >> "${file}"
    alias "${name}=${value}"
    echo "added: alias ${name}=\"${escaped}\""
}

# npm: refuse global installs, which bypass the Brewfiles; use npx or bunx, or
# a Brewfile (homebrew/README.md, "Where a tool comes from"). Global uninstalls
# and everything else pass through. NPM_ALLOW_GLOBAL=1 allows one.
npm() {
    local arg global=false install=false
    for arg in "$@"; do
        case "${arg}" in
            -g | --global | --location=global) global=true ;;
            i | in | ins | inst | insta | instal | install | isnt | isnta | isntal | isntall | add | update | up | upgrade | link | ln) install=true ;;
        esac
    done
    if [[ "${global}" == true && "${install}" == true && -z "${NPM_ALLOW_GLOBAL:-}" ]]; then
        printf 'npm: global installs are off on this machine; use npx or bunx, or add it to a Brewfile (NPM_ALLOW_GLOBAL=1 to override)\n' >&2
        return 1
    fi
    command npm "$@"
}
