#!/usr/bin/env bash

set -euo pipefail

# Shared helpers from the dotfiles repo, reached through this script's stow
# link; DOTFILES_DIR names the repo when a copy runs from elsewhere.
DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../.." && pwd)}"
# shellcheck source=scripts/common.sh
source "${DOTFILES_DIR}/scripts/common.sh"

ADB_BIN="${ADB_BIN:-adb}"
FIRETV_HOST="${FIRETV_HOST:-192.168.0.84:5555}"
FIRETV_STATE_DIR="${FIRETV_STATE_DIR:-${XDG_STATE_HOME:-${HOME}/.local/state}/firetv}"
# ph talks to the Pi-hole for packages ADB cannot disable; it sits beside
# this script, so a run from the repo finds it too.
PH_BIN="${PH_BIN:-$(command -v ph || printf '%s' "${DOTFILES_DIR}/stow/personal/.local/bin/ph")}"

# The debloat list: group, package, what it is. Launcher, settings, the app
# store, OTA updates, account services, and the stock screensaver stay on.
PACKAGES="$(cat <<'EOF'
telemetry	com.amazon.tv.acr	Content recognition (watches the screen)
telemetry	com.amazon.device.metrics	Device metrics
telemetry	com.amazon.device.telemetry.emitter	Telemetry
telemetry	com.amazon.wirelessmetrics.service	Wi-Fi metrics
telemetry	com.amazon.perfcollection	Performance collection
telemetry	com.amazon.perfc	Performance collection
telemetry	com.amazon.hybridadidservice	Ad ID
ads	com.amazon.ftvads.deeplinking	Ad deep links
ads	com.amazon.sneakpeek	Promo previews
ads	com.amazon.shoptv.client	Shopping
ads	com.amazon.tv.earlyaccess	Early access promos
ads	com.amazon.tv.democontent.provider	Demo content
bloat	com.amazon.minitv.android.app	miniTV
bloat	com.amazon.gamehub	Game hub
bloat	com.amazon.bueller.music	Music
bloat	com.amazon.bueller.photos	Photos
bloat	com.amazon.storm.lightning.tutorial	Tutorial
bloat	com.amazon.tmm.tutorial	Tutorial
EOF
)"
GROUPS_ALL="telemetry ads bloat"

# Hosts the TV needs; doctor fails when the deny list holds one and never
# offers to block them or the HOST_KEEP patterns. Without ktpx.amazon.com Home
# shows "Home is Currently Unavailable".
NEEDED_HOSTS="firetvcaptiveportal.com arcus-uswest.amazon.com dp-gw-na.amazon.com device-messaging-na.amazon.com appstore-tv-prod-na.amazon.com ktpx.amazon.com m.media-amazon.com api.amazon.com softwareupdates.amazon.com www.amazon.com"
HOST_KEEP="${NEEDED_HOSTS// /|}"
HOST_KEEP="^(${HOST_KEEP//./\\.}|"'cognito-(identity|idp)\.[a-z0-9-]+\.amazonaws\.com|[a-z0-9-]+\.cloudfront\.net)$'

# Packages the TV needs; doctor fails if any is disabled, and disable refuses
# them. Beyond the launcher, settings, store, OTA, sign-in and screensaver:
# Home starts media.recommendations, most Amazon apps need client.metrics.api,
# Prime Video needs dp.logger, tcomm and aria are boot-logo suspects, imp and
# tv.oobe sign in, tv.livetv and tv.channelscan are the tuner.
CORE_PACKAGES="com.amazon.tv.launcher com.amazon.firehomestarter com.amazon.tv.settings.v2 com.amazon.venezia com.amazon.device.software.ota com.amazon.identity.auth.device.authorization com.amazon.ftv.screensaver com.amazon.media.recommendations com.amazon.dp.logger com.amazon.client.metrics.api com.amazon.tcomm com.amazon.aria com.amazon.imp com.amazon.tv.oobe com.amazon.tv.livetv com.amazon.tv.channelscan"

# Your own tweaks, same format as TWEAKS; firetv settings-diff prints lines for it.
TWEAKS_FILE="${FIRETV_TWEAKS_FILE:-${XDG_CONFIG_HOME:-${HOME}/.config}/firetv/tweaks}"
# Doctor warns below this much free storage, in KB.
LOW_STORAGE_KB=1048576

DRY_RUN=false
WATCH_SECONDS=30
SHOW_ALL=false
DIG_BIN="${DIG_BIN:-dig}"
# The Mac's resolver by default, which is normally the Pi-hole the TV uses.
FIRETV_DNS="${FIRETV_DNS:-}"
COMMAND=""
declare -a COMMAND_ARGS=()

usage() {
    show_help <<EOF
# firetv

Debloat the TCL Fire TV over ADB (Fire OS 8). Packages are disabled with \`pm disable-user\`, never uninstalled, so \`enable\` undoes everything.

## Usage

    firetv [--host IP[:PORT]] [--dry-run] [--watch SECONDS] COMMAND [ARGS]
    firetv --help

## Commands

| Command | What it does |
|---|---|
| \`connect\` | Connect and check the TV accepted this Mac |
| \`backup\` | Save the full package list to ${FIRETV_STATE_DIR} |
| \`disable TARGET...\` | Disable packages: a group (telemetry, ads, bloat, all) or a package name; core packages are refused |
| \`enable TARGET...\` | Re-enable them, or any package by name |
| \`list [GROUP...]\` | Show the debloat list: enabled, disabled, or absent |
| \`doctor\` | Check adb, the connection, core apps, the debloat list, and, for packages that need root, that the Pi-hole blocks the hosts in their code the TV looks up; offers to block the rest |
| \`domains PACKAGE\` | The domains a package uses: hostnames built into its code that the TV has looked up, then what it connects to while watched; each with the Pi-hole's verdict |
| \`animations [fast\|normal]\` | Show the animation speed, or set it: fast is 0.5x, normal is Android's 1x |
| \`tweaks\` | List the tweaks, each on, off, or partly on |
| \`tweak NAME on\|off\` | Apply a tweak, saving the values it replaces; off puts them back |
| \`settings-diff [reset]\` | Find a setting's key: run once, change the setting in the TV's menus, run again to see what changed; reset drops the saved snapshot |
| \`clean\` | Trim app caches and show the storage freed |
| \`apps\` | List the apps you installed, with version codes |
| \`install FILE.apk\` | Sideload an app, or update one in place (needs Apps from unknown sources on) |
| \`uninstall PACKAGE\` | Remove an app you installed and its data, after asking; built-in and core packages are refused |
| \`reboot\` | Restart the TV |
| \`disconnect\` | Drop the ADB connection |

## Options

| Option | What it does |
|---|---|
| \`--host IP[:PORT]\` | The TV (default ${FIRETV_HOST}; or set FIRETV_HOST) |
| \`-n\`, \`--dry-run\` | Show what disable or enable would change |
| \`-w\`, \`--watch SECS\` | domains: how long to watch connections (default 30; 0 skips watching). Use the app meanwhile to see more. |
| \`-a\`, \`--all\` | domains: also list built-in hostnames the TV never looked up (mostly SDK tables, rarely called) |
| \`-h\`, \`--help\` | Show this help |

## First run

On the TV, Settings > My Fire TV > About, click the device name 7 times; then Developer options > ADB debugging on. Install adb with \`brew install --cask android-platform-tools\`.

Tweaks: built in are Android settings; add your own to ${TWEAKS_FILE}, one per line: NAME, then system|secure|global, KEY, VALUE, DESCRIPTION, tab-separated. A name on several lines sets each key.

Pi-hole: doctor checks and blocks through ph, with its PIHOLE_URL and saved password; run \`ph login\` once.

## Examples

- \`firetv backup\`, then \`firetv disable telemetry\`, reboot and check the TV, then \`firetv disable ads bloat\`
- \`firetv --dry-run disable all\`: see what would change

Fire OS updates can re-enable packages; run disable again. Turn ADB debugging off when done.
EOF
}

parse_args() {
    while (($# > 0)); do
        case "$1" in
            --host)
                [[ $# -ge 2 && -n "$2" ]] || die "--host needs an address"
                FIRETV_HOST="$2"
                shift 2
                ;;
            --host=*) FIRETV_HOST="${1#--host=}"; shift ;;
            -n|--dry-run) DRY_RUN=true; shift ;;
            -a|--all) SHOW_ALL=true; shift ;;
            -w|--watch)
                [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || die "--watch needs a number of seconds"
                WATCH_SECONDS="$2"
                shift 2
                ;;
            -h|--help|help) usage; exit 0 ;;
            -*) die "Unknown option: $1 (see firetv --help)" ;;
            *)
                if [[ -z "${COMMAND}" ]]; then
                    COMMAND="$1"
                else
                    COMMAND_ARGS+=("$1")
                fi
                shift
                ;;
        esac
    done
    [[ -n "${COMMAND}" ]] || { usage >&2; exit 2; }
    [[ "${FIRETV_HOST}" == *:* ]] || FIRETV_HOST="${FIRETV_HOST}:5555"
}

# "group<TAB>package<TAB>about" for the named groups and packages, each once;
# a package off the debloat list comes out under "other".
select_packages() {
    local target group
    local -a wanted=() names=()

    for target in "$@"; do
        case "${target}" in
            all) read -r -a wanted <<< "${GROUPS_ALL}" ;;
            telemetry|ads|bloat)
                [[ " ${wanted[*]-} " == *" ${target} "* ]] || wanted+=("${target}")
                ;;
            *)
                # Names go into shell commands on the TV; accept only plain ones.
                [[ "${target}" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+$ ]] \
                    || die "Unknown group or package: ${target} (telemetry, ads, bloat, all, or a package name)"
                names+=("${target}")
                ;;
        esac
    done
    {
        for group in ${wanted[@]+"${wanted[@]}"}; do
            printf '%s\n' "${PACKAGES}" | awk -F'\t' -v g="${group}" '$1 == g'
        done
        for target in ${names[@]+"${names[@]}"}; do
            printf '%s\n' "${PACKAGES}" | awk -F'\t' -v p="${target}" '
                $2 == p { print; found = 1 }
                END { if (!found) printf "other\t%s\t(not on the debloat list)\n", p }'
        done
    } | awk -F'\t' '!seen[$2]++'
}

require_adb() {
    command -v "${ADB_BIN}" >/dev/null 2>&1 \
        || die "adb not found. Install it: brew install --cask android-platform-tools"
}

# adb shell reads stdin, which would swallow the package list a loop reads.
adb_tv() {
    "${ADB_BIN}" -s "${FIRETV_HOST}" "$@" < /dev/null
}

# Connect and check the TV has authorized this machine. On failure, set
# CONNECT_ERROR and return 1.
CONNECT_ERROR=""
connect_tv() {
    local output state

    output="$("${ADB_BIN}" connect "${FIRETV_HOST}" 2>&1 || true)"
    case "${output}" in
        *"connected to"*) ;;
        *refused*)
            CONNECT_ERROR="The TV at ${FIRETV_HOST} refused ADB. If it just rebooted, wait a minute and try again; otherwise check Developer options > ADB debugging is on."
            return 1
            ;;
        *)
            CONNECT_ERROR="Could not reach the TV at ${FIRETV_HOST}: ${output}. Is it on and on the network?"
            return 1
            ;;
    esac
    state="$(adb_tv get-state 2>&1 || true)"
    if [[ "${state}" == *offline* ]]; then
        "${ADB_BIN}" disconnect "${FIRETV_HOST}" >/dev/null 2>&1 || true
        "${ADB_BIN}" connect "${FIRETV_HOST}" >/dev/null 2>&1 || true
        state="$(adb_tv get-state 2>&1 || true)"
    fi
    case "${state}" in
        device) return 0 ;;
        *unauthorized*) CONNECT_ERROR="The TV has not authorized this Mac. Accept the prompt on the TV, then run firetv connect again." ;;
        *) CONNECT_ERROR="The TV at ${FIRETV_HOST} is not ready: ${state}" ;;
    esac
    return 1
}

ensure_connected() {
    require_adb
    connect_tv || die "${CONNECT_ERROR}"
}

# Packages a disable found need root, remembered so doctor does not flag them.
NEEDS_ROOT_FILE="${FIRETV_STATE_DIR}/needs-root"

remember_needs_root() {
    mkdir -p "${FIRETV_STATE_DIR}"
    grep -qxF "$1" "${NEEDS_ROOT_FILE}" 2>/dev/null || printf '%s\n' "$1" >> "${NEEDS_ROOT_FILE}"
}

# Package names on the TV: all of them, or only disabled ones with -d.
tv_packages() {
    local output

    output="$(adb_tv shell pm list packages "$@" 2>&1)" \
        || die "Could not list packages on the TV: ${output}"
    printf '%s\n' "${output}" | tr -d '\r' | sed -n 's/^package://p'
}

cmd_connect() {
    ensure_connected
    _check "Connected to ${FIRETV_HOST}"
    _item "$(adb_tv shell getprop ro.product.model | tr -d '\r'), $(adb_tv shell getprop ro.build.version.name | tr -d '\r')"
}

cmd_backup() {
    local file

    ensure_connected
    mkdir -p "${FIRETV_STATE_DIR}"
    file="${FIRETV_STATE_DIR}/packages-$(date +%Y%m%d-%H%M%S).txt"
    adb_tv shell pm list packages -f | tr -d '\r' > "${file}"
    _check "Saved $(wc -l < "${file}" | tr -d ' ') packages to ${file}"
}

cmd_list() {
    local installed disabled group pkg about state
    local -a groups=("$@")

    ((${#groups[@]} > 0)) || groups=(all)
    select_packages "${groups[@]}" > /dev/null
    ensure_connected
    installed="$(tv_packages)" || exit 1
    disabled="$(tv_packages -d)" || exit 1
    while IFS=$'\t' read -r group pkg about; do
        if ! grep -qxF "${pkg}" <<< "${installed}"; then
            state="absent"
        elif grep -qxF "${pkg}" <<< "${disabled}"; then
            state="disabled"
        else
            state="enabled"
        fi
        printf '%-9s  %-9s  %-38s %s\n' "${state}" "${group}" "${pkg}" "${about}"
    done < <(select_packages "${groups[@]}")
}

# Disable or enable each package of the groups, skipping those already there.
change_packages() {
    local action="$1" installed disabled group pkg about output
    local changed=0 skipped=0 rooted=0 failed=0
    shift

    (($# > 0)) || die "Name a group (telemetry, ads, bloat, all) or a package"
    select_packages "$@" > /dev/null
    if [[ "${action}" == disable ]]; then
        for pkg in "$@"; do
            [[ " ${CORE_PACKAGES} " != *" ${pkg} "* ]]                 || die "${pkg} is a core package the TV needs; firetv will not disable it"
        done
    fi
    ensure_connected
    installed="$(tv_packages)" || exit 1
    disabled="$(tv_packages -d)" || exit 1
    [[ -n "${installed}" ]] || die "The TV listed no packages; is ${FIRETV_HOST} the TV?"

    while IFS=$'\t' read -r group pkg about; do
        if ! grep -qxF "${pkg}" <<< "${installed}"; then
            _skip "${pkg}: not on this TV"
            skipped=$((skipped + 1))
            continue
        fi
        if [[ "${action}" == disable ]] && grep -qxF "${pkg}" <<< "${disabled}"; then
            _skip "${pkg}: already disabled"
            skipped=$((skipped + 1))
            continue
        fi
        if [[ "${action}" == enable ]] && ! grep -qxF "${pkg}" <<< "${disabled}"; then
            _skip "${pkg}: already enabled"
            skipped=$((skipped + 1))
            continue
        fi
        if [[ "${DRY_RUN}" == true ]]; then
            _item "would ${action} ${pkg} (${about})"
            changed=$((changed + 1))
            continue
        fi

        if [[ "${action}" == disable ]]; then
            output="$(adb_tv shell pm disable-user --user 0 "${pkg}" 2>&1 | tr -d '\r' || true)"
        else
            output="$(adb_tv shell pm enable "${pkg}" 2>&1 | tr -d '\r' || true)"
        fi
        case "${action}:${output}" in
            disable:*"new state: disabled-user"*|enable:*"new state: enabled"*)
                _check "${pkg}: ${action}d (${about})"
                changed=$((changed + 1))
                ;;
            *SecurityException*)
                _skip "${pkg}: needs root; block its traffic on the Pi-hole instead"
                remember_needs_root "${pkg}"
                rooted=$((rooted + 1))
                ;;
            *)
                _cross "${pkg}: ${output:-no output}"
                failed=$((failed + 1))
                ;;
        esac
    done < <(select_packages "$@")

    if [[ "${DRY_RUN}" == true ]]; then
        _success "Dry run: ${changed} to ${action}, ${skipped} skipped"
    else
        _success "${changed} ${action}d, ${skipped} skipped, ${rooted} need root, ${failed} failed"
        ((changed == 0)) || _item "Changes apply now; reboot to check the TV still behaves: firetv reboot"
    fi
    ((failed == 0))
}

PIHOLE_ERROR=""

# From ph check's JSON: "blocked" when a deny rule or blocklist matches and no
# allow rule or allowlist does, else "not blocked"; an error on any other reply.
# shellcheck disable=SC2016 # jq variables, not shell ones
VERDICT_JQ='
    if (.search | type) != "object" then error("not a search reply") else
    [(.search.domains // [])[] | select(.enabled != false) | .type] as $rules
    | [(.search.gravity // [])[] | select(.enabled != false) | .type] as $lists
    | if (($rules | index("deny")) or ($lists | index("block")))
         and ((($rules | index("allow")) or ($lists | index("allow"))) | not)
      then "blocked" else "not blocked" end end'

pihole_deny() {
    local response

    if ! response="$("${PH_BIN}" --json deny -c "firetv: domains of packages ADB cannot disable" "$@" 2>&1)"; then
        PIHOLE_ERROR="${response#ph: }"
        return 1
    fi
    if ! jq -e '.processed and ((.processed.errors // []) | length == 0)' <<< "${response}" >/dev/null 2>&1; then
        PIHOLE_ERROR="$(jq -r '[(.processed.errors // [])[] | "\(.item): \(.error)"] | join("; ")' <<< "${response}" 2>/dev/null || true)"
        PIHOLE_ERROR="${PIHOLE_ERROR:-unexpected reply: ${response}}"
        return 1
    fi
}

# A needs-root package with no hostnames in its code: pass on a clean watch
# of this same version, else say to watch it.
doctor_watched() {
    local pkg="$1" version record watched_version seconds date result

    version="$(package_version "${pkg}")"
    record="$(awk -F'\t' -v p="${pkg}" '$1 == p' "${WATCHED_FILE}" 2>/dev/null || true)"
    IFS=$'\t' read -r _ watched_version seconds date result <<< "${record}"
    if [[ -n "${record}" && "${watched_version}" == "${version}" && "${result}" == clean ]]; then
        doctor_result PASS "${pkg} needs root; no hostnames in its code, no connections in a ${seconds}s watch on ${date}"
        return 0
    fi
    if [[ -z "${record}" ]]; then
        doctor_result WARN "${pkg} needs root and has no hostnames in its code; watch what it connects to"
    elif [[ "${watched_version}" != "${version}" ]]; then
        doctor_result WARN "${pkg} needs root and changed version since the watch on ${date}; watch it again"
    else
        doctor_result WARN "${pkg} needs root and made connections in the watch on ${date}; see what they are"
    fi
    add_next_step "firetv --watch 120 domains ${pkg}"
}

# For each package that needs root: the hostnames in its code that the TV
# looked up, which the Pi-hole blocks, and an offer to block the rest.
doctor_pihole() {
    local pkg hosts seen summary host n verdict answer
    local -a unblocked=() pkg_blocked=() pkg_open=() pkg_kept=() candidates=()

    if [[ ! -x "${PH_BIN}" ]] && ! command -v "${PH_BIN}" >/dev/null 2>&1; then
        doctor_result WARN "Need root, so still on: $*; Pi-hole not checked: ph not found"
        return 0
    fi
    if ! command -v jq >/dev/null 2>&1; then
        doctor_result WARN "Need root, so still on: $*; Pi-hole not checked: jq not found"
        add_next_step "brew install jq"
        return 0
    fi
    load_tv_log
    if [[ -z "${TV_LOG}" ]]; then
        doctor_result WARN "Need root, so still on: $*; Pi-hole not checked: ${PIHOLE_ERROR:-no queries from the TV in its log}"
        [[ "${PIHOLE_ERROR}" != *"ph login"* ]] || add_next_step "ph login"
        return 0
    fi
    summary="$(tv_log_summary)"

    for pkg in "$@"; do
        hosts="$(code_hostnames "${pkg}")"
        if [[ -z "${hosts}" ]]; then
            doctor_watched "${pkg}"
            continue
        fi
        seen="$(awk -F'\t' 'NR == FNR { want[$1]; next } $1 in want' <(printf '%s\n' "${hosts}") <(printf '%s\n' "${summary}"))"
        if [[ -z "${seen}" ]]; then
            doctor_result PASS "${pkg} needs root; the TV looked up none of the $(grep -c . <<< "${hosts}") hostnames in its code"
            continue
        fi

        pkg_blocked=() pkg_open=() pkg_kept=() candidates=()
        while IFS=$'\t' read -r host n verdict; do
            if [[ "${verdict}" == blocked ]]; then
                pkg_blocked+=("${host}")
            elif [[ "${host}" =~ ${HOST_KEEP} ]]; then
                pkg_kept+=("${host}")
            else
                candidates+=("${host}")
            fi
        done <<< "${seen}"
        # The log may predate a block added since, so ask the Pi-hole now.
        if ((${#candidates[@]} > 0)); then
            while IFS=$'\t' read -r host verdict; do
                case "${verdict}" in
                    blocked) pkg_blocked+=("${host}") ;;
                    "not blocked")
                        pkg_open+=("${host}")
                        [[ " ${unblocked[*]-} " == *" ${host} "* ]] || unblocked+=("${host}")
                        ;;
                    *)
                        doctor_result WARN "${pkg}: ph could not check ${host}"
                        ;;
                esac
            done < <(printf '%s\n' "${candidates[@]}" | pihole_verdicts | sort)
        fi

        if ((${#pkg_open[@]} > 0)); then
            doctor_result WARN "${pkg} needs root; Pi-hole does not block ${pkg_open[*]}"
        elif ((${#pkg_blocked[@]} > 0)); then
            doctor_result PASS "${pkg} needs root; Pi-hole blocks what the TV looks up from its code: ${pkg_blocked[*]}"
        else
            doctor_result PASS "${pkg} needs root; the TV looks up only hosts it needs from its code"
        fi
        ((${#pkg_kept[@]} == 0)) || _item "left alone, the TV needs them: ${pkg_kept[*]}"
    done

    if ((${#unblocked[@]} > 0)); then
        answer="$(choose_one "Block ${#unblocked[@]} domain(s) on the Pi-hole: ${unblocked[*]}?" no \
            $'Yes, block them\tyes' $'No\tno')"
        if [[ "${answer}" == yes ]]; then
            if pihole_deny "${unblocked[@]}"; then
                doctor_result PASS "Pi-hole now blocks ${unblocked[*]}"
            else
                doctor_result FAIL "Pi-hole did not block them: ${PIHOLE_ERROR}"
            fi
        else
            add_next_step "ph deny ${unblocked[*]}"
        fi
    fi
}

# Fail when the Pi-hole's deny list holds a host the TV needs; one ph call.
doctor_needed_hosts() {
    local response denied host
    local -a hit=()

    if ! response="$("${PH_BIN}" --json list deny 2>&1)" \
        || ! denied="$(jq -r '.domains[] | select(.kind == "exact" and .enabled != false) | .domain' <<< "${response}" 2>/dev/null)"; then
        doctor_result WARN "Pi-hole deny list not checked: ${response#ph: }"
        return 0
    fi
    for host in ${NEEDED_HOSTS}; do
        grep -qxF "${host}" <<< "${denied}" && hit+=("${host}")
    done
    if ((${#hit[@]} > 0)); then
        doctor_result FAIL "Pi-hole denies hosts the TV needs: ${hit[*]}"
        add_next_step "ph undeny ${hit[*]}"
    else
        doctor_result PASS "Pi-hole denies none of the hosts the TV needs"
    fi
}

doctor_result() {
    local kind="$1" message="$2"

    add_result "${kind}" "${message}"
    case "${kind}" in
        PASS) _check "${message}" ;;
        WARN) _caution "${message}" ;;
        FAIL) _cross "${message}" ;;
    esac
}

cmd_doctor() {
    local installed disabled pkg group about latest
    local -a off_core=() missing_core=() pending=() rooted=()
    local present done_count free_kb

    _header "firetv doctor: ${FIRETV_HOST}"

    if ! command -v "${ADB_BIN}" >/dev/null 2>&1; then
        doctor_result FAIL "adb is not installed"
        add_next_step "brew install --cask android-platform-tools"
        print_summary
        return
    fi
    doctor_result PASS "adb $("${ADB_BIN}" version 2>/dev/null | sed -n '1s/.*version //p')"

    if ! connect_tv; then
        doctor_result FAIL "${CONNECT_ERROR}"
        print_summary
        return
    fi
    doctor_result PASS "Connected and authorized"
    doctor_result PASS "$(adb_tv shell getprop ro.product.model | tr -d '\r'), $(adb_tv shell getprop ro.build.version.name | tr -d '\r')"

    if ! installed="$(tv_packages 2>&1)" || ! disabled="$(tv_packages -d 2>&1)"; then
        doctor_result FAIL "Could not list packages on the TV"
        print_summary
        return
    fi

    for pkg in ${CORE_PACKAGES}; do
        if ! grep -qxF "${pkg}" <<< "${installed}"; then
            missing_core+=("${pkg}")
        elif grep -qxF "${pkg}" <<< "${disabled}"; then
            off_core+=("${pkg}")
            add_next_step "adb -s ${FIRETV_HOST} shell pm enable ${pkg}"
        fi
    done
    if ((${#off_core[@]} > 0)); then
        doctor_result FAIL "Core packages disabled: ${off_core[*]}"
    else
        doctor_result PASS "Core packages enabled ($(wc -w <<< "${CORE_PACKAGES}" | tr -d ' '): launcher, home, settings, store, OTA, sign-in, Prime Video, TV inputs)"
    fi
    ((${#missing_core[@]} == 0)) || doctor_result WARN "Core packages not on this TV: ${missing_core[*]}"

    for group in ${GROUPS_ALL}; do
        pending=()
        present=0
        done_count=0
        while IFS=$'\t' read -r _ pkg about; do
            grep -qxF "${pkg}" <<< "${installed}" || continue
            present=$((present + 1))
            if grep -qxF "${pkg}" <<< "${disabled}"; then
                done_count=$((done_count + 1))
            elif grep -qxF "${pkg}" "${NEEDS_ROOT_FILE}" 2>/dev/null; then
                rooted+=("${pkg}")
            else
                pending+=("${pkg}")
            fi
        done < <(select_packages "${group}")
        if ((present == 0)); then
            doctor_result PASS "${group}: none on this TV"
        elif ((${#pending[@]} > 0)); then
            doctor_result WARN "${group}: ${done_count} of ${present} disabled; still on: ${pending[*]}"
            add_next_step "firetv disable ${group}"
        else
            doctor_result PASS "${group}: ${done_count} of ${present} disabled"
        fi
    done
    ((${#rooted[@]} == 0)) || doctor_pihole "${rooted[@]}"
    have_ph && doctor_needed_hosts

    latest=""
    if [[ -d "${FIRETV_STATE_DIR}" ]]; then
        latest="$(find "${FIRETV_STATE_DIR}" -maxdepth 1 -name 'packages-*.txt' | sort | tail -n 1)"
    fi
    if [[ -n "${latest}" ]]; then
        doctor_result PASS "Backup: ${latest}"
    else
        doctor_result WARN "No package backup yet"
        add_next_step "firetv backup"
    fi

    free_kb="$(storage_free_kb)"
    if [[ -z "${free_kb}" ]]; then
        doctor_result WARN "Could not read the TV's free storage"
    elif ((free_kb < LOW_STORAGE_KB)); then
        doctor_result WARN "Storage low: $((free_kb / 1024)) MB free"
        add_next_step "firetv clean"
    else
        doctor_result PASS "Storage: $((free_kb / 1024)) MB free"
    fi

    add_next_step "Turn ADB debugging off on the TV when you are done"
    print_summary
}

# Hostnames in a package's code: its APKs' dex files and the odex and vdex
# beside them. Only hosts in URLs or under known services count; a looser
# match takes in Java names, stray bytes and SDK tables.
HOST_SERVICES='amazon|amazonaws|a2z|amazon-adsystem|amazonvideo|media-amazon|cloudfront|crashlytics|appsflyer|scorecardresearch|newrelic|nr-data|firebaseio|doubleclick|googleapis|branch'

code_hostnames() {
    local pkg="$1" path dirs="" apks=""

    while IFS= read -r path; do
        # Paths go into a shell command on the TV; accept only plain ones.
        [[ "${path}" =~ ^/[A-Za-z0-9/._+-]+\.apk$ ]] || continue
        apks+=" ${path}"
        [[ " ${dirs} " == *" ${path%/*} "* ]] || dirs+=" ${path%/*}"
    done < <(adb_tv shell pm path "${pkg}" | tr -d '\r' | sed -n 's/^package://p')
    [[ -n "${apks}" ]] || return 0

    adb_tv shell "{ for a in${apks}; do unzip -p \"\$a\" '*.dex' 2>/dev/null; done; find${dirs} -name '*.odex' -o -name '*.vdex' 2>/dev/null | while read -r f; do cat \"\$f\"; done; } | strings -n 6 | grep -oE 'https?://[A-Za-z0-9.-]+|[a-z0-9-]+(\.[a-z0-9-]+)*\.(${HOST_SERVICES})\.(com|net|dev|io)' | sort -u" \
        | tr -d '\r' \
        | sed -E 's#^https?://##' \
        | tr '[:upper:]' '[:lower:]' \
        | grep -E '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$' \
        | grep -vE '\.(af|ap|ca|cn|eu|il|me|mx|sa|us-gov)-[a-z]+-[0-9]+\.amazonaws\.com$|(^|\.)(example|localhost|test)(\.|$)|^[0-9.]+$' \
        | grep -vE '^[0-9]*(com|org|net|android|androidx|java|javax|kotlin|kotlinx)\.' \
        | grep -E '\.[a-z]{2,}$' \
        | sort -u \
        || true
}

# Remote addresses the package's app ID holds sockets to, sampled each second
# for WATCH_SECONDS, as the kernel's hex ADDR:PORT.
watched_addresses() {
    local uid="$1"

    adb_tv shell "end=\$((\$(date +%s) + ${WATCH_SECONDS})); while [ \$(date +%s) -lt \$end ]; do cat /proc/net/tcp /proc/net/tcp6 /proc/net/udp /proc/net/udp6 2>/dev/null | awk -v u=${uid} '\$8 == u && \$3 !~ /^0+:/ { print \$3 }'; sleep 1; done | sort -u" \
        | tr -d '\r'
}

# Turn the kernel's hex ADDR:PORT into "IP PORT"; IPv4, plain or mapped into
# IPv6, is little-endian per 32-bit word. Loopback and unset addresses drop.
decode_address() {
    local hex="${1%%:*}" port="${1##*:}" word ip=""

    if ((${#hex} == 32)) && [[ "${hex}" == 0000000000000000FFFF0000* ]]; then
        hex="${hex:24:8}"
    fi
    if ((${#hex} == 8)); then
        ip="$((16#${hex:6:2})).$((16#${hex:4:2})).$((16#${hex:2:2})).$((16#${hex:0:2}))"
        [[ "${ip}" != 127.* && "${ip}" != 0.0.0.0 ]] || return 0
    elif ((${#hex} == 32)); then
        for word in "${hex:0:8}" "${hex:8:8}" "${hex:16:8}" "${hex:24:8}"; do
            ip+="${word:6:2}${word:4:2}:${word:2:2}${word:0:2}:"
        done
        ip="$(printf '%s' "${ip%:}" | tr 'A-F' 'a-f')"
        [[ "${ip}" != 0000:0000:0000:0000:0000:0000:0000:0001 ]] || return 0
    else
        return 0
    fi
    printf '%s %s\n' "${ip}" "$((16#${port}))"
}

# Pi-hole statuses that mean the query was blocked.
BLOCKED_STATUSES='GRAVITY|DENYLIST|REGEX|BLOCKED|SPECIAL|BLACKLIST'

# The TV's recent queries from the Pi-hole log, "DOMAIN<TAB>STATUS" newest
# first; empty when ph or jq is missing or fails.
TV_LOG=""
TV_LOG_LOADED=false
load_tv_log() {
    [[ "${TV_LOG_LOADED}" == false ]] || return 0
    TV_LOG_LOADED=true
    local response

    command -v jq >/dev/null 2>&1 || return 0
    if ! response="$("${PH_BIN}" --json -n 10000 queries "${FIRETV_HOST%:*}" 2>&1)"; then
        PIHOLE_ERROR="${response#ph: }"
        return 0
    fi
    TV_LOG="$(jq -r '.queries[] | select(.domain | test("^[A-Za-z0-9._-]+$")) | [.domain, (.status // "")] | @tsv' <<< "${response}" 2>/dev/null || true)"
}

# "DOMAIN<TAB>LOOKUPS<TAB>VERDICT" for each domain in the TV log, by the
# newest query's status.
tv_log_summary() {
    awk -F'\t' -v blocked="^(${BLOCKED_STATUSES})" '
        !($1 in n) { order[++k] = $1; v[$1] = ($2 ~ blocked) ? "blocked" : "allowed" }
        { n[$1]++ }
        END { for (i = 1; i <= k; i++) printf "%s\t%d\t%s\n", order[i], n[order[i]], v[order[i]] }
    ' <<< "${TV_LOG}"
}

# "IP DOMAIN" for the domains the TV looked up and was answered, as the
# resolver answers them now.
recent_lookups() {
    local resolve
    # Run by sh for each domain: $0 is dig, $1 the DNS server or empty, $2 the domain.
    # shellcheck disable=SC2016
    resolve='"$0" +short +time=2 +tries=1 ${1:+"@$1"} A "$2" 2>/dev/null | grep -E "^[0-9.]+$" | sed "s|\$| $2|"'

    tv_log_summary | awk -F'\t' '$3 == "allowed" { print $1 }' \
        | xargs -P 16 -n 1 sh -c "${resolve}" "${DIG_BIN}" "${FIRETV_DNS}" 2>/dev/null \
        || true
}

# "DOMAIN<TAB>VERDICT" from ph check, four at a time, one short line per job so
# output never interleaves. The Pi-hole rate-limits logins, so failures retry.
pihole_verdicts() {
    local check
    # $0 is ph, $1 jq's filter, $2 the domain.
    # shellcheck disable=SC2016
    check='for wait in 1 2 4 0; do v="$("$0" --json check "$2" 2>/dev/null | jq -r "$1" 2>/dev/null)" && [ -n "$v" ] && break; v=""; sleep "$wait"; done; printf "%s\t%s\n" "$2" "${v:-?}"'

    xargs -P 4 -n 1 sh -c "${check}" "${PH_BIN}" "${VERDICT_JQ}"
}

have_ph() {
    command -v jq >/dev/null 2>&1 && { [[ -x "${PH_BIN}" ]] || command -v "${PH_BIN}" >/dev/null 2>&1; }
}

# Watches of packages that need root, so doctor can trust a clean one:
# "PACKAGE<TAB>VERSIONCODE<TAB>SECONDS<TAB>DATE<TAB>clean|connections".
WATCHED_FILE="${FIRETV_STATE_DIR}/watched"

# A package's versionCode from dumpsys; empty when it isn't on the TV.
package_version() {
    adb_tv shell dumpsys package "$1" | tr -d '\r' | sed -n 's/^ *versionCode=\([0-9][0-9]*\).*/\1/p' | head -n 1
}

record_watch() {
    local pkg="$1" version="$2" result="$3"

    [[ -n "${version}" ]] || return 0
    mkdir -p "${FIRETV_STATE_DIR}"
    {
        awk -F'\t' -v p="${pkg}" '$1 != p' "${WATCHED_FILE}" 2>/dev/null || true
        printf '%s\t%s\t%s\t%s\t%s\n' "${pkg}" "${version}" "${WATCH_SECONDS}" "$(date +%Y-%m-%d)" "${result}"
    } > "${WATCHED_FILE}.tmp"
    mv "${WATCHED_FILE}.tmp" "${WATCHED_FILE}"
}

cmd_domains() {
    local pkg="$1" dump uid version hosts summary seen unseen line ip port names lookups count
    local -a addresses=()

    [[ "${pkg}" =~ ^[A-Za-z0-9._]+$ ]] || die "Not a package name: ${pkg}"
    ensure_connected
    dump="$(adb_tv shell dumpsys package "${pkg}" | tr -d '\r')"
    uid="$(sed -n 's/^ *userId=\([0-9][0-9]*\).*/\1/p' <<< "${dump}" | head -n 1)"
    version="$(sed -n 's/^ *versionCode=\([0-9][0-9]*\).*/\1/p' <<< "${dump}" | head -n 1)"
    [[ -n "${uid}" ]] || die "${pkg} is not on this TV"

    _header "${pkg} (app ID ${uid})"
    have_ph && load_tv_log
    [[ -n "${TV_LOG}" ]] || _item "No Pi-hole log (ph login?); verdicts and lookups are left out"
    summary="$(tv_log_summary)"

    hosts="$(code_hostnames "${pkg}")"
    printf '\n'
    if [[ -z "${hosts}" ]]; then
        _header "Built into its code"
        _item "none found (the code may live in a shared library)"
    elif [[ -z "${TV_LOG}" ]]; then
        _header "Built into its code"
        while IFS= read -r line; do _item "${line}"; done <<< "${hosts}"
    else
        # Built-in hosts the TV looked up, most looked-up first.
        seen="$(awk -F'\t' 'NR == FNR { want[$1]; next } $1 in want' <(printf '%s\n' "${hosts}") <(printf '%s\n' "${summary}") | sort -t$'\t' -k2,2nr)"
        unseen="$(awk -F'\t' 'NR == FNR { have[$1]; next } !($1 in have)' <(printf '%s\n' "${summary}") <(printf '%s\n' "${hosts}"))"
        count="$(grep -c . <<< "${hosts}")"
        _header "Built into its code and looked up by the TV ($(grep -c . <<< "${seen}") of ${count})"
        if [[ -z "${seen}" ]]; then
            _item "none in the Pi-hole's last 10000 queries from the TV"
        else
            while IFS=$'\t' read -r host n verdict; do
                printf '  %-48s %-8s %6s lookups\n' "${host}" "${verdict}" "${n}"
            done <<< "${seen}"
        fi
        if [[ -n "${unseen}" && "${SHOW_ALL}" == true ]]; then
            printf '\n'
            _header "Built in, never looked up"
            while IFS=$'\t' read -r host verdict; do
                printf '  %-48s %s\n' "${host}" "${verdict}"
            done < <(printf '%s\n' "${unseen}" | pihole_verdicts | sort)
        elif [[ -n "${unseen}" ]]; then
            _item "$(grep -c . <<< "${unseen}") more never looked up; --all lists them"
        fi
    fi

    ((WATCH_SECONDS > 0)) || return 0
    printf '\n'
    _header "Connections in ${WATCH_SECONDS}s"
    while IFS= read -r line; do
        [[ -z "${line}" ]] || addresses+=("${line}")
    done < <(watched_addresses "${uid}" | while IFS= read -r line; do decode_address "${line}"; done | sort -u)
    if ((${#addresses[@]} == 0)); then
        _item "none (an app blocked by the Pi-hole never connects; try using the app while watching)"
        record_watch "${pkg}" "${version}" clean
        return 0
    fi
    record_watch "${pkg}" "${version}" connections
    lookups=""
    [[ -z "${TV_LOG}" ]] || lookups="$(recent_lookups)"
    for line in "${addresses[@]}"; do
        ip="${line% *}"
        port="${line#* }"
        names="$(awk -v ip="${ip}" '$1 == ip { print $2 }' <<< "${lookups}" | sort -u | paste -sd ' ' -)"
        printf '  %-40s %s\n' "${ip}:${port}" "${names:-(no recent lookup matches)}"
    done
}

ANIMATION_SETTINGS="window_animation_scale transition_animation_scale animator_duration_scale"

# Android's three animation scales: 0.5 halves every animation, 1 is stock.
cmd_animations() {
    local mode="${1:-}" scale="" key value

    case "${mode}" in
        '') ;;
        fast) scale=0.5 ;;
        normal) scale=1 ;;
        *) die "animations takes fast or normal, not ${mode}" ;;
    esac
    ensure_connected
    for key in ${ANIMATION_SETTINGS}; do
        [[ -z "${scale}" ]] || adb_tv shell settings put global "${key}" "${scale}"
        value="$(adb_tv shell settings get global "${key}" | tr -d '\r')"
        # Unset means Android's default, 1.
        [[ "${value}" != null ]] || value="1 (default)"
        printf '  %-28s %s\n' "${key}" "${value}"
    done
    [[ -z "${scale}" ]] || _check "Animations set to ${mode} (${scale}x)"
}

# Built-in tweaks: NAME, NAMESPACE, KEY, VALUE when on, DESCRIPTION. Only
# Android's own settings; find Amazon's with settings-diff.
TWEAKS="$(cat <<'EOF'
fast-animations	global	window_animation_scale	0.5	Animations at 0.5x
fast-animations	global	transition_animation_scale	0.5	Animations at 0.5x
fast-animations	global	animator_duration_scale	0.5	Animations at 0.5x
no-wifi-scan	global	wifi_scan_always_enabled	0	No Wi-Fi scanning while Wi-Fi is off or connected
no-ble-scan	global	ble_scan_always_enabled	0	No background Bluetooth LE scanning
EOF
)"
TWEAKS_SAVED_FILE="${FIRETV_STATE_DIR}/tweaks-saved"

# Settings keys and values go into shell commands on the TV; accept only
# plain ones.
plain_key() { [[ "$1" =~ ^[A-Za-z0-9_.:-]+$ ]]; }
plain_value() { [[ "$1" =~ ^[A-Za-z0-9_.,:/+-]*$ ]]; }

# Every tweak line, built in then yours; lines that fail the checks are
# skipped with a warning.
all_tweaks() {
    local name ns key value about

    {
        printf '%s\n' "${TWEAKS}"
        [[ ! -r "${TWEAKS_FILE}" ]] || grep -v -E '^[[:space:]]*(#|$)' "${TWEAKS_FILE}"
    } | while IFS=$'\t' read -r name ns key value about; do
        if [[ "${name}" =~ ^[a-z0-9][a-z0-9-]*$ && "${ns}" =~ ^(system|secure|global)$ ]] \
            && plain_key "${key}" && [[ -n "${value}" ]] && plain_value "${value}"; then
            printf '%s\t%s\t%s\t%s\t%s\n' "${name}" "${ns}" "${key}" "${value}" "${about}"
        else
            log_warn "Skipping tweak line: ${name} ${ns} ${key} ${value}"
        fi
    done
}

setting_get() {
    adb_tv shell settings get "$1" "$2" | tr -d '\r'
}

saved_value() {
    awk -F'\t' -v ns="$1" -v k="$2" '$1 == ns && $2 == k { v = $3; found = 1 } END { if (found) print v; exit !found }' \
        "${TWEAKS_SAVED_FILE}" 2>/dev/null
}

cmd_tweaks() {
    local tweaks name ns key value about desc current on total state
    local -a names=()

    tweaks="$(all_tweaks)"
    ensure_connected
    while IFS= read -r name; do names+=("${name}"); done < <(cut -f1 <<< "${tweaks}" | awk '!seen[$0]++')
    for name in "${names[@]}"; do
        on=0 total=0 desc=""
        while IFS=$'\t' read -r _ ns key value about; do
            desc="${about}"
            current="$(setting_get "${ns}" "${key}")"
            total=$((total + 1))
            [[ "${current}" != "${value}" ]] || on=$((on + 1))
        done < <(awk -F'\t' -v n="${name}" '$1 == n' <<< "${tweaks}")
        if ((on == total)); then state=on; elif ((on == 0)); then state=off; else state=partly; fi
        printf '  %-18s %-7s %s\n' "${name}" "${state}" "${desc}"
    done
}

cmd_tweak() {
    local name="${1:-}" action="${2:-}" rows ns key value current saved changed=0

    [[ -n "${name}" && "${action}" =~ ^(on|off)$ ]] || die "Use: firetv tweak NAME on|off (see firetv tweaks)"
    rows="$(all_tweaks | awk -F'\t' -v n="${name}" '$1 == n')"
    [[ -n "${rows}" ]] || die "Unknown tweak: ${name} (see firetv tweaks)"
    ensure_connected
    mkdir -p "${FIRETV_STATE_DIR}"

    while IFS=$'\t' read -r _ ns key value _; do
        current="$(setting_get "${ns}" "${key}")"
        if [[ "${action}" == on ]]; then
            if ! saved_value "${ns}" "${key}" >/dev/null; then
                # A value that can't be written back safely can't be restored.
                if ! plain_value "${current}"; then
                    _cross "${ns} ${key}: current value can't be saved safely; left as is"
                    continue
                fi
                printf '%s\t%s\t%s\n' "${ns}" "${key}" "${current}" >> "${TWEAKS_SAVED_FILE}"
            fi
            adb_tv shell settings put "${ns}" "${key}" "${value}"
            _check "${ns} ${key}: ${current} -> ${value}"
            changed=$((changed + 1))
        else
            if ! saved="$(saved_value "${ns}" "${key}")"; then
                _skip "${ns} ${key}: no saved value; left at ${current}"
                continue
            fi
            if [[ "${saved}" == null ]]; then
                adb_tv shell settings delete "${ns}" "${key}" >/dev/null
            else
                adb_tv shell settings put "${ns}" "${key}" "${saved}"
            fi
            awk -F'\t' -v ns="${ns}" -v k="${key}" '!($1 == ns && $2 == k)' "${TWEAKS_SAVED_FILE}" > "${TWEAKS_SAVED_FILE}.tmp"
            mv "${TWEAKS_SAVED_FILE}.tmp" "${TWEAKS_SAVED_FILE}"
            _check "${ns} ${key}: ${current} -> ${saved} (restored)"
            changed=$((changed + 1))
        fi
    done <<< "${rows}"
    _success "${name} ${action}: ${changed} setting(s) changed"
}

# Every setting as NAMESPACE<TAB>KEY<TAB>VALUE.
settings_snapshot() {
    local ns

    for ns in system secure global; do
        adb_tv shell settings list "${ns}" | tr -d '\r' \
            | awk -v ns="${ns}" 'index($0, "=") { i = index($0, "="); printf "%s\t%s\t%s\n", ns, substr($0, 1, i - 1), substr($0, i + 1) }'
    done
}

cmd_settings_diff() {
    local snapshot="${FIRETV_STATE_DIR}/settings-snapshot" now changes

    case "${1:-}" in
        '') ;;
        reset)
            rm -f "${snapshot}"
            _check "Snapshot dropped"
            return 0
            ;;
        *) die "settings-diff takes only reset" ;;
    esac
    ensure_connected
    mkdir -p "${FIRETV_STATE_DIR}"
    if [[ ! -s "${snapshot}" ]]; then
        settings_snapshot > "${snapshot}"
        _check "Saved $(grep -c . "${snapshot}") settings"
        _item "Change one setting in the TV's menus, then run firetv settings-diff again"
        return 0
    fi

    now="$(settings_snapshot)"
    changes="$(awk -F'\t' '
        NR == FNR { old[$1 "\t" $2] = $3; next }
        { k = $1 "\t" $2; seen[k]; if (!(k in old)) print "added\t" k "\t(unset)\t" $3; else if (old[k] != $3) print "changed\t" k "\t" old[k] "\t" $3 }
        END { for (k in old) if (!(k in seen)) print "removed\t" k "\t" old[k] "\t(unset)" }
    ' "${snapshot}" <(printf '%s\n' "${now}") | sort -t$'\t' -k2,3)"
    # A missing value is "(unset)", since read with a tab IFS merges empty fields.
    rm -f "${snapshot}"
    if [[ -z "${changes}" ]]; then
        _item "No settings changed; the TV may keep this one elsewhere"
        return 0
    fi
    _header "Changed settings"
    while IFS=$'\t' read -r kind ns key old new; do
        printf '  %-8s %-7s %-40s %s -> %s\n' "${kind}" "${ns}" "${key}" "${old}" "${new}"
    done <<< "${changes}"
    printf '\n'
    _header "Lines for ${TWEAKS_FILE} (rename and describe)"
    while IFS=$'\t' read -r kind ns key old new; do
        if [[ "${kind}" == removed ]] || ! plain_key "${key}" || ! plain_value "${new}"; then
            continue
        fi
        printf 'my-tweak\t%s\t%s\t%s\tDescribe it\n' "${ns}" "${key}" "${new}"
    done <<< "${changes}"
}

# Free space on /data in KB.
storage_free_kb() {
    adb_tv shell df -k /data | tr -d '\r' | awk 'NR == 2 && $4 ~ /^[0-9]+$/ { print $4 }'
}

cmd_clean() {
    local before after

    ensure_connected
    before="$(storage_free_kb)"
    adb_tv shell pm trim-caches 999G >/dev/null
    after="$(storage_free_kb)"
    [[ -n "${before}" && -n "${after}" ]] || die "Could not read the TV's free storage"
    _check "App caches trimmed: $(((after - before) / 1024)) MB freed, $((after / 1024)) MB free"
}

# Apps installed after the factory image, "PACKAGE<TAB>VERSIONCODE", minus
# Amazon's resource overlays (*.overlay.*, version 0), which are the system's.
user_apps() {
    adb_tv shell pm list packages -3 --show-versioncode | tr -d '\r' \
        | sed -n 's/^package:\([^ ]*\) versionCode:\([0-9]*\)$/\1	\2/p' \
        | { grep -v '\.overlay\.' || true; } \
        | sort
}

cmd_apps() {
    local apps pkg version

    ensure_connected
    apps="$(user_apps)" || die "Could not list the TV's apps"
    if [[ -z "${apps}" ]]; then
        _item "No apps installed beyond the built-in ones"
        return 0
    fi
    while IFS=$'\t' read -r pkg version; do
        printf '  %-44s %s\n' "${pkg}" "${version}"
    done <<< "${apps}"
}

cmd_install() {
    local file="$1" output

    [[ "${file}" == *.apk ]] || die "Not an APK: ${file}"
    [[ -f "${file}" ]] || die "No such file: ${file}"
    ensure_connected
    output="$(adb_tv install -r "${file}" 2>&1 | tr -d '\r' || true)"
    case "${output}" in
        *Success*) _check "Installed ${file##*/}" ;;
        *INSTALL_FAILED_VERIFICATION_FAILURE*|*"unknown sources"*)
            die "The TV refused ${file##*/}: turn on Developer options > Apps from unknown sources" ;;
        *) die "Install failed: ${output}" ;;
    esac
}

cmd_uninstall() {
    local pkg="$1" answer output

    [[ "${pkg}" =~ ^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+$ ]] || die "Not a package name: ${pkg}"
    [[ " ${CORE_PACKAGES} " != *" ${pkg} "* ]] || die "${pkg} is a core package the TV needs; firetv will not remove it"
    [[ "${pkg}" != *.overlay.* ]] || die "${pkg} is a system resource overlay; firetv will not remove it"
    ensure_connected
    if ! user_apps | cut -f1 | grep -qxF "${pkg}"; then
        if tv_packages | grep -qxF "${pkg}"; then
            die "${pkg} is built in and can't be uninstalled; firetv disable ${pkg} turns it off instead"
        fi
        die "${pkg} is not on this TV"
    fi
    answer="$(choose_one "Uninstall ${pkg} and delete its data?" no $'Yes, uninstall\tyes' $'No\tno')"
    if [[ "${answer}" != yes ]]; then
        _skip "${pkg} kept"
        return 0
    fi
    output="$(adb_tv uninstall "${pkg}" 2>&1 | tr -d '\r' || true)"
    [[ "${output}" == *Success* ]] || die "Uninstall failed: ${output}"
    _check "Uninstalled ${pkg}"
}

main() {
    parse_args "$@"
    case "${COMMAND}" in
        list|disable|enable) ;;
        domains) ((${#COMMAND_ARGS[@]} == 1)) || die "domains takes one package (see firetv --help)" ;;
        animations) ((${#COMMAND_ARGS[@]} <= 1)) || die "animations takes fast or normal (see firetv --help)" ;;
        tweak) ((${#COMMAND_ARGS[@]} == 2)) || die "Use: firetv tweak NAME on|off (see firetv tweaks)" ;;
        settings-diff) ((${#COMMAND_ARGS[@]} <= 1)) || die "settings-diff takes only reset" ;;
        install) ((${#COMMAND_ARGS[@]} == 1)) || die "install takes one APK file (see firetv --help)" ;;
        uninstall) ((${#COMMAND_ARGS[@]} == 1)) || die "uninstall takes one package (see firetv --help)" ;;
        *) ((${#COMMAND_ARGS[@]} == 0)) || die "${COMMAND} takes no arguments (see firetv --help)" ;;
    esac
    case "${COMMAND}" in
        connect) cmd_connect ;;
        backup) cmd_backup ;;
        disable|enable) change_packages "${COMMAND}" ${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"} ;;
        list) cmd_list ${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"} ;;
        doctor) cmd_doctor ;;
        domains) cmd_domains "${COMMAND_ARGS[0]}" ;;
        animations) cmd_animations ${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"} ;;
        tweaks) cmd_tweaks ;;
        tweak) cmd_tweak "${COMMAND_ARGS[@]}" ;;
        settings-diff) cmd_settings_diff ${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"} ;;
        clean) cmd_clean ;;
        apps) cmd_apps ;;
        install) cmd_install "${COMMAND_ARGS[0]}" ;;
        uninstall) cmd_uninstall "${COMMAND_ARGS[0]}" ;;
        reboot) ensure_connected; adb_tv reboot; _check "Rebooting ${FIRETV_HOST}" ;;
        disconnect) require_adb; "${ADB_BIN}" disconnect "${FIRETV_HOST}" ;;
        *) die "Unknown command: ${COMMAND} (see firetv --help)" ;;
    esac
}

main "$@"
