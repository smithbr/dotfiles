#!/usr/bin/env bash
# Start managing something with the dotfiles:
#   df-add brew NAME...  install packages and record them in a Brewfile
#   df-add stow PATH...  copy files from ~ into a layer and link them

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: df-add brew [OPTIONS] NAME...   (scripts/brew-add.sh --help)
       df-add stow [OPTIONS] PATH...   (link.sh add; see df-link --help)
EOF
}

# Follow the stow symlink chain without GNU readlink -f, which macOS lacks.
resolve_script_path() {
    local path="${1}" dir target
    while [[ -L "${path}" ]]; do
        dir="$(cd -P "$(dirname "${path}")" && pwd)"
        target="$(readlink "${path}")"
        case "${target}" in
            /*) path="${target}" ;;
            *) path="${dir}/${target}" ;;
        esac
    done
    printf '%s/%s\n' "$(cd -P "$(dirname "${path}")" && pwd)" "$(basename "${path}")"
}

# The script lives at <repo>/stow/tools/.local/bin/df-add.
repo="$(cd "$(dirname "$(resolve_script_path "${BASH_SOURCE[0]}")")/../../../.." && pwd)"

case "${1:-}" in
    brew) script=brew-add.sh ;;
    stow) script=link.sh ;;
    -h|--help) usage; exit 0 ;;
    *)
        usage >&2
        exit 2
        ;;
esac
shift
if [[ ! -f "${repo}/scripts/${script}" ]]; then
    printf 'df-add: cannot find scripts/%s in %s\n' "${script}" "${repo}" >&2
    exit 1
fi
if [[ "${script}" == link.sh ]]; then
    exec bash "${repo}/scripts/link.sh" add "$@"
fi
exec bash "${repo}/scripts/brew-add.sh" "$@"
