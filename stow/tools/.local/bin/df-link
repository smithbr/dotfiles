#!/usr/bin/env bash
# Run the dotfiles link step from anywhere: link.sh add, status, managed, persona, ...

set -euo pipefail

# The script lives at <repo>/stow/tools/.local/bin/df-link, reached through its stow link.
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../.." && pwd)"
if [[ ! -f "${repo}/scripts/link.sh" ]]; then
    printf 'df-link: cannot find scripts/link.sh in %s\n' "${repo}" >&2
    exit 1
fi
exec bash "${repo}/scripts/link.sh" "$@"
