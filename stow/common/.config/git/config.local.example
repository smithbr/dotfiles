# Machine-specific git config overrides
# Copy to ~/.config/git/config.local
#
# Platform settings come from the persona's layers and need no copying:
# config.desktop (Mac editor, keychain, 1Password signing) and config.server
# (Linux delta, vimdiff, keys on disk). Anything set here overrides them.

# [user]
#     signingkey = ssh-ed25519 AAAA ...
