#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

printf 'pre-push: running shellcheck and test suite\n'
./tests/run_tests.sh

# A sandbox install boots a container and takes minutes, so only pay for it when
# the pushed commits touch something that can break a fresh install.
INSTALL_PATHS='^(install\.sh|scripts/|dotfiles/|homebrew/|tests/sandbox-install\.sh)'
ZERO='0000000000000000000000000000000000000000'

needs_sandbox() {
    local local_sha remote_sha
    local saw_input=0

    while read -r _ local_sha _ remote_sha; do
        saw_input=1
        # Branch deletion: nothing to install-test.
        [[ "${local_sha}" == "${ZERO}" ]] && continue
        # New branch: no remote side to diff against, so check it.
        [[ "${remote_sha}" == "${ZERO}" ]] && return 0
        if git diff --name-only "${remote_sha}..${local_sha}" | grep -qE "${INSTALL_PATHS}"; then
            return 0
        fi
    done

    # Invoked by hand rather than by git: run the check.
    [[ "${saw_input}" -eq 0 ]] && return 0
    return 1
}

if [[ "${SKIP_SANDBOX_INSTALL:-0}" == "1" ]]; then
    printf 'pre-push: sandbox install skipped (SKIP_SANDBOX_INSTALL=1)\n'
elif ! command -v docker >/dev/null 2>&1; then
    # No container runtime on this host (e.g. a fresh machine mid-bootstrap).
    printf 'pre-push: docker not found; skipping sandbox install\n'
elif needs_sandbox; then
    printf 'pre-push: running dotfiles install in a container\n'
    ./tests/sandbox-install.sh
else
    printf 'pre-push: no install-affecting changes; skipping sandbox install\n'
fi
