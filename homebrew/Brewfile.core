# Install all dependencies with: brew bundle
# Usage: brew bundle [--file=Brewfile.core]

# Core Tools
brew "agent-browser"
brew "bottom"
brew "difftastic"
brew "domain-check"
brew "fd"
brew "fzf"
brew "gh"
brew "ghq"
brew "git-delta"
brew "git-lfs"
brew "glances"
brew "go"
brew "jq"
brew "lazygit"
brew "llmfit"
brew "markdownlint-cli2"
brew "node"
brew "ripgrep"
brew "shellcheck"
brew "skills"
brew "stow"
brew "tmux"
brew "uv"
brew "xdg-ninja", args: ["HEAD"]

# Shell Enhancements
brew "antidote"
brew "asciiquarium"
brew "bat"
brew "eza"
brew "fastfetch"
brew "glow"
brew "gum"
brew "nerdfetch"
brew "onefetch"
brew "starship"
brew "yazi"
brew "zoxide"
brew "zsh"

# macOS only: Homebrew on Linux has no casks.
if OS.mac?
  cask "1password-cli"
  cask "google-chrome"
  cask "iterm2"

  # Fonts
  cask "font-0xproto-nerd-font"
  cask "font-caskaydia-cove-nerd-font"
  cask "font-fantasque-sans-mono-nerd-font"
  cask "font-fira-code-nerd-font"
  cask "font-hack-nerd-font"
  cask "font-iosevka-nerd-font"
  cask "font-jetbrains-mono-nerd-font"
  cask "font-meslo-lg-nerd-font"
  cask "font-mononoki-nerd-font"
  cask "font-sauce-code-pro-nerd-font"
end
