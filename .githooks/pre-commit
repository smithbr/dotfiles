#!/usr/bin/env bash
# Run the agents repo's check-drift before every commit: it scans this repo for
# retired terms and checks link.sh's AGENT_LINKS against ~/.config/agents.
# Bypass once: git commit --no-verify

set -euo pipefail

CHECK_DRIFT="${HOME}/.config/agents/scripts/check-drift"

if [[ ! -x "${CHECK_DRIFT}" ]]; then
    # Agents checkout not cloned yet (fresh machine, CI): nothing to check against.
    printf 'pre-commit: %s not found; skipping check-drift\n' "${CHECK_DRIFT}"
    exit 0
fi

printf 'pre-commit: running check-drift\n'
status=0
"${CHECK_DRIFT}" || status=$?

# Above 128 is a signal, not a FAIL line: the check itself died, so the
# drift report above is incomplete rather than wrong.
if [[ "${status}" -gt 128 ]]; then
    printf 'pre-commit: check-drift crashed (signal %s), not a drift failure; run %s by hand to see whether it passes\n' \
        "$((status - 128))" "${CHECK_DRIFT}" >&2
    exit 1
elif [[ "${status}" -ne 0 ]]; then
    printf 'pre-commit: check-drift failed; see ~/.config/agents/MAINTENANCE.md\n' >&2
    exit 1
fi
