#!/usr/bin/env bash
# Run the dotfiles link step from anywhere: link.sh add, status, managed, persona, ...

set -euo pipefail

# Follow the stow symlink chain without GNU readlink -f, which macOS lacks.
resolve_script_path() {
    local path="${1}" dir target
    while [[ -L "${path}" ]]; do
        dir="$(cd -P "$(dirname "${path}")" && pwd)"
        target="$(readlink "${path}")"
        case "${target}" in
            /*) path="${target}" ;;
            *) path="${dir}/${target}" ;;
        esac
    done
    printf '%s/%s\n' "$(cd -P "$(dirname "${path}")" && pwd)" "$(basename "${path}")"
}

# The script lives at <repo>/stow/tools/.local/bin/df-link.
repo="$(cd "$(dirname "$(resolve_script_path "${BASH_SOURCE[0]}")")/../../../.." && pwd)"
if [[ ! -f "${repo}/scripts/link.sh" ]]; then
    printf 'df-link: cannot find scripts/link.sh in %s\n' "${repo}" >&2
    exit 1
fi
exec bash "${repo}/scripts/link.sh" "$@"
