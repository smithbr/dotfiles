#!/usr/bin/env bash
# Review files in the home directory and pick leftovers to archive. With no
# arguments it runs file-review.sh --cleanup; any arguments go to it as they are.

set -euo pipefail

# Follow the stow symlink chain without GNU readlink -f, which macOS lacks.
resolve_script_path() {
    local path="${1}" dir target
    while [[ -L "${path}" ]]; do
        dir="$(cd -P "$(dirname "${path}")" && pwd)"
        target="$(readlink "${path}")"
        case "${target}" in
            /*) path="${target}" ;;
            *) path="${dir}/${target}" ;;
        esac
    done
    printf '%s/%s\n' "$(cd -P "$(dirname "${path}")" && pwd)" "$(basename "${path}")"
}

# The script lives at <repo>/stow/tools/.local/bin/df-file-review.
repo="$(cd "$(dirname "$(resolve_script_path "${BASH_SOURCE[0]}")")/../../../.." && pwd)"
if [[ ! -f "${repo}/scripts/file-review.sh" ]]; then
    printf 'df-file-review: cannot find scripts/file-review.sh in %s\n' "${repo}" >&2
    exit 1
fi
if [[ $# -eq 0 ]]; then
    set -- --cleanup
fi
exec bash "${repo}/scripts/file-review.sh" "$@"
