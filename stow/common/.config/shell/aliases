# navigation
alias h="history"
alias hg="history 1 | rg "
alias ls="eza --group-directories-first"
alias lsa="eza -laF --git --group-directories-first"
alias xb="cd ~/.local/bin"
alias xc="cd ~/.config"
alias xn="xdg-ninja --skip-ok --skip-unsupported"
alias pi="ssh pihole"

# shell
alias c="claude"
alias ddf="cd ~/.dotfiles"
alias ff="fastfetch -c all"
alias rl="exec ${SHELL} -l"
alias skill-drop="~/.config/agents/scripts/skills-add -D"

# system
if command -v mactop >/dev/null 2>&1; then
    alias top="mactop"
else
    alias top="btm"
fi

# brew
alias brewls="brew list --formula -t"

# docker
alias dclean="docker system prune -af"
alias dlogs="docker logs -f"
alias dps="docker ps"
alias dpsa="docker ps -a"
alias drm="docker rm \$(docker ps -a -q)"
alias drmi="docker rmi \$(docker images -q)"
alias dstop="docker stop \$(docker ps -q)"

# network
alias dns="cat /etc/resolv.conf"
alias ip_public="dig +short myip.opendns.com @resolver1.opendns.com"
case "${OSTYPE}" in
    darwin*)
        alias df="df -H"
        alias ip_local="ipconfig getifaddr en0"
        alias flushdns="dscacheutil -flushcache"
        ;;
    linux*)
        alias df="df -HT"
        alias ip_local="hostname -I"
        alias flushdns="sudo resolvectl flush-caches"
        alias nethogs="sudo nethogs"
        ;;
esac

# remove junk files
alias cleanupds="find . -type f -name '*.DS_Store' -ls -delete"
alias emptyfolders="find . -type d -empty"

# domain lookup
alias tld="domain-check --preset startup --pretty"

# generate random token
alias newtoken="openssl rand -hex 32"
