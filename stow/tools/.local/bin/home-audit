#!/usr/bin/env bash
#
# home-audit — sort the dotfiles directly in $HOME into what to do with them.
#
# Read-only. Each top-level ~/.* entry lands in one bucket:
#
#   JUNK      OS litter and backup copies (.DS_Store, *.bak, .zcompdump, ...)
#   LEFTOVER  your environment already redirects this tool to an XDG path, or
#             nothing installed owns it and it has not changed in --days
#   MOVE      the tool supports XDG; the note says how (from xdg-ninja's data)
#   REVIEW    owner unclear, or owner installed but untouched in --days
#   KEEP      managed by the dotfiles repo, required, in active use, or cannot move
#
# XDG knowledge comes from xdg-ninja's program database; the repo's
# scripts/link.sh managed list marks what the dotfiles repo owns. To archive
# what you decide against, run ~/.dotfiles/scripts/file-review.sh --cleanup.
#
# Each note says when the entry last changed, so an entry whose owner cannot
# be found can still be judged by age.
#
# Usage:
#   home-audit [--days N] [--home PATH] [--all] [--tsv]
#
#   --days N     inactivity threshold in days (default 90)
#   --home PATH  audit another home directory (default $HOME)
#   --all        also list KEEP entries
#   --tsv        print every entry, KEEP included, as
#                bucket<TAB>path<TAB>size<TAB>note lines for scripts
#                (file-review.sh uses this)
#
# Environment:
#   HOME_AUDIT_PROGRAMS  xdg-ninja programs directory (auto-detected)
#   HOME_AUDIT_PREFIXES  prefixes searched for share/xdg-ninja/programs
#                        (default: $HOMEBREW_PREFIX and the usual Homebrew
#                        and system prefixes)
#   DOTFILES_DIR         dotfiles repo (default ~/.dotfiles)

set -euo pipefail

days=90
home_dir="${HOME}"
show_all=0
tsv=0

usage() {
    sed -n '3,/^$/{s/^# \{0,1\}//;p;}' "$0"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --days)
            [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { echo "home-audit: --days needs a number" >&2; exit 2; }
            days="$2"
            shift 2
            ;;
        --home)
            [[ $# -ge 2 && -d "$2" ]] || { echo "home-audit: --home needs a directory" >&2; exit 2; }
            home_dir="${2%/}"
            shift 2
            ;;
        --all) show_all=1; shift ;;
        --tsv) tsv=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "home-audit: unknown argument: $1" >&2; exit 2 ;;
    esac
done

# Present on every macOS/Linux home or owned by this dotfiles setup.
required_names=" .Trash .ssh .gnupg .config .local .cache .dotfiles .zshenv .CFUserTextEncoding .localized "

# Looks in Homebrew's usual prefixes rather than running brew, which is slow
# and must not run during an install dry run.
find_programs_dir() {
    local dir
    if [[ -n "${HOME_AUDIT_PROGRAMS:-}" ]]; then
        printf '%s\n' "${HOME_AUDIT_PROGRAMS}"
        return
    fi
    local -a prefixes=()
    read -r -a prefixes <<< "${HOME_AUDIT_PREFIXES-${HOMEBREW_PREFIX:-} /opt/homebrew /home/linuxbrew/.linuxbrew /usr/local /usr}"
    for dir in ${prefixes[@]+"${prefixes[@]/%//share/xdg-ninja/programs}"}; do
        [[ -n "${dir}" && -d "${dir}" ]] && { printf '%s\n' "${dir}"; return; }
    done
    # Not found is fine: the XDG checks are skipped and noted.
    return 0
}

# name<TAB>program<TAB>movable<TAB>VAR,VAR<TAB>hint for every $HOME/.name entry.
xdg_db=""
programs_dir="$(find_programs_dir)"
if [[ -n "${programs_dir}" ]] && command -v jq >/dev/null 2>&1; then
    xdg_db="$(jq -r '
        .name as $prog | .files[]
        | select(.path | test("^\\$HOME/\\.[^/]+$"))
        | [ (.path | sub("^\\$HOME/"; "")),
            $prog,
            (.movable | tostring),
            ([.help | scan("export ([A-Z_][A-Z0-9_]*)=")[]] | join(",")),
            ((.help | split("\n") | map(select(test("^export ")))) as $e
              | if ($e | length) > 0 then ($e | join("; "))
                else (.help | split("\n") | map(select(length > 0)) | first // "" | gsub("[*`]"; "")) end)
          ] | @tsv' "${programs_dir}"/*.json 2>/dev/null || true)"
fi

managed=""
link_script="${DOTFILES_DIR:-${HOME}/.dotfiles}/scripts/link.sh"
if [[ -f "${link_script}" ]]; then
    managed="$(bash "${link_script}" --destination "${home_dir}" managed 2>/dev/null || true)"
fi

is_managed() {
    local path="$1"
    [[ -n "${managed}" ]] && grep -qxF -e "${path}" -e "${path}/" <<<"${managed}" && return 0
    [[ -n "${managed}" ]] && grep -qF "${path}/" <<<"${managed}"
}

# stat arguments that print a modification time in epoch seconds (GNU, then BSD).
if stat -c %Y / >/dev/null 2>&1; then
    mtime_args=(-c %Y)
else
    mtime_args=(-f %m)
fi
now="$(date +%s)"

# Whole days since anything at or under the path (two levels deep) changed.
age_days() {
    local newest
    newest="$(find "$1" -maxdepth 2 -print0 2>/dev/null | xargs -0 stat "${mtime_args[@]}" 2>/dev/null | sort -n | tail -n 1 || true)"
    [[ "${newest}" =~ ^[0-9]+$ ]] || newest="${now}"
    printf '%d\n' $(((now - newest) / 86400))
}

age_text() {
    case "$1" in
        0) printf 'changed today' ;;
        1) printf 'changed yesterday' ;;
        *) printf 'changed %d days ago' "$1" ;;
    esac
}

# Folders named after a product rather than its command.
owner_alias() {
    case "$1" in
        vscode*) printf 'code\n' ;;
        microsandbox) printf 'msb\n' ;;
        factory) printf 'droid\n' ;;
        kimi-code) printf 'kimi\n' ;;
    esac
}

find_owner() {
    local name="$1" program="$2" base candidate app
    base="$(printf '%s' "${name#.}" | tr '[:upper:]' '[:lower:]')"
    for candidate in "${program}" "$(owner_alias "${base}")" "${base}" "${base%%[-_.]*}"; do
        [[ -n "${candidate}" ]] || continue
        if command -v "${candidate}" >/dev/null 2>&1; then
            printf '%s\n' "${candidate}"
            return
        fi
    done
    if [[ "$(uname -s)" == Darwin ]]; then
        for app in /Applications/*.app "${home_dir}/Applications"/*.app; do
            [[ -e "${app}" ]] || continue
            candidate="$(basename "${app}" .app | tr '[:upper:]' '[:lower:]' | tr -d ' ')"
            if [[ "${candidate}" == *"${base%%[-_.]*}"* ]]; then
                basename "${app}"
                return
            fi
        done
    fi
}

size_of() {
    du -sk "$1" 2>/dev/null | awk '{ kb = $1; if (kb >= 1048576) printf "%.1fG", kb/1048576; else if (kb >= 1024) printf "%.0fM", kb/1024; else printf "%dK", kb }' || true
}

# File names and environment values reach the terminal; replace control
# characters (escape sequences, tabs, newlines) so they cannot drive it or
# break the tab-separated rows.
printable() {
    printf '%s' "$1" | LC_ALL=C tr '\000-\037\177' '?'
}

declare -a junk=() leftover=() move=() review=() keep=()

# Rows are path<TAB>display<TAB>size<TAB>note.
add() {
    local bucket="$1" path="$2" note="$3" line size=""
    # Kept entries include ~/.cache and ~/.local, too big to size on every run.
    [[ "${bucket}" == keep ]] || size="$(size_of "${path}")"
    # shellcheck disable=SC2088 # literal ~ for display
    line="$(printf '%s\t%s\t%s\t%s' "$(printable "${path}")" "$(printable "~/${path#"${home_dir}"/}")" "${size}" "$(printable "${note}")")"
    case "${bucket}" in
        junk) junk+=("${line}") ;;
        leftover) leftover+=("${line}") ;;
        move) move+=("${line}") ;;
        review) review+=("${line}") ;;
        keep) keep+=("${line}") ;;
    esac
}

shopt -s dotglob nullglob
for path in "${home_dir}"/.*; do
    name="${path##*/}"
    [[ "${name}" == "." || "${name}" == ".." ]] && continue

    case "${name}" in
        .DS_Store | *.bak | *.backup | *.old | *.orig | *.swp | *~ | .zcompdump*)
            add junk "${path}" "backup copy or OS litter"
            continue
            ;;
    esac

    if is_managed "${path}"; then
        add keep "${path}" "managed by dotfiles"
        continue
    fi
    if [[ "${required_names}" == *" ${name} "* ]]; then
        add keep "${path}" "required"
        continue
    fi
    if [[ "${name}" == .1password ]]; then
        add keep "${path}" "1Password SSH agent socket link, made by the shell config"
        continue
    fi

    entry="$(awk -F'\t' -v n="${name}" '$1 == n { print; exit }' <<<"${xdg_db}")"
    program="" movable="" vars="" hint=""
    # Tab is IFS whitespace, so read would merge an empty vars field into the next; split on \x1f.
    [[ -n "${entry}" ]] && IFS=$'\x1f' read -r _ program movable vars hint <<<"${entry//$'\t'/$'\x1f'}"

    if [[ "${movable}" == true ]]; then
        redirected=""
        IFS=',' read -r -a var_list <<<"${vars}"
        for var in ${var_list[@]+"${var_list[@]}"}; do
            [[ "${var}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
            value="${!var:-}"
            if [[ -n "${value}" && "${value}" != "${path}" && "${value}" != "${path}/"* ]]; then
                redirected="${var}"
                break
            fi
        done
        if [[ -n "${redirected}" ]]; then
            add leftover "${path}" "${program}: \$${redirected} already points to ${!redirected}"
        else
            add move "${path}" "${program}: ${hint:-supports XDG}"
        fi
        continue
    fi
    if [[ "${movable}" == false ]]; then
        add keep "${path}" "${program}: no XDG support"
        continue
    fi

    owner="$(find_owner "${name}" "${program}")"
    age="$(age_days "${path}")"
    if [[ "${age}" -lt "${days}" ]]; then
        if [[ -n "${owner}" ]]; then
            add keep "${path}" "in use by ${owner}; $(age_text "${age}")"
        else
            add review "${path}" "no installed owner found, but $(age_text "${age}")"
        fi
    elif [[ -n "${owner}" ]]; then
        add review "${path}" "${owner} installed, but untouched ${age} days"
    else
        add leftover "${path}" "no installed owner, untouched ${age} days"
    fi
done

bold="" dim="" reset=""
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
    bold=$'\033[1m' dim=$'\033[2m' reset=$'\033[0m'
fi

print_bucket() {
    local title="$1" desc="$2"
    shift 2
    [[ $# -gt 0 ]] || return 0
    printf '\n%s%s (%d)%s %s%s%s\n' "${bold}" "${title}" "$#" "${reset}" "${dim}" "${desc}" "${reset}"
    printf '%s\n' "$@" | awk -F'\t' '{ printf "  %-28s %6s  %s\n", $2, $3, $4 }'
}

print_tsv() {
    local bucket="$1"
    shift
    [[ $# -gt 0 ]] || return 0
    printf '%s\n' "$@" | awk -F'\t' -v b="${bucket}" 'BEGIN { OFS = "\t" } { print b, $1, $3, $4 }'
}

if [[ "${tsv}" -eq 1 ]]; then
    print_tsv junk ${junk[@]+"${junk[@]}"}
    print_tsv leftover ${leftover[@]+"${leftover[@]}"}
    print_tsv move ${move[@]+"${move[@]}"}
    print_tsv review ${review[@]+"${review[@]}"}
    print_tsv keep ${keep[@]+"${keep[@]}"}
    exit 0
fi

printf '%sHome audit%s %s(%s, inactive = %s+ days)%s\n' "${bold}" "${reset}" "${dim}" "$(printable "${home_dir}")" "${days}" "${reset}"
[[ -n "${xdg_db}" ]] || printf '%snote: xdg-ninja data or jq not found; XDG checks skipped%s\n' "${dim}" "${reset}"
[[ -n "${managed}" ]] || printf '%snote: dotfiles repo not found; managed files not recognised%s\n' "${dim}" "${reset}"

print_bucket JUNK "safe to remove by hand" ${junk[@]+"${junk[@]}"}
print_bucket LEFTOVER "likely safe to archive" ${leftover[@]+"${leftover[@]}"}
print_bucket MOVE "tool supports XDG" ${move[@]+"${move[@]}"}
print_bucket REVIEW "check by hand" ${review[@]+"${review[@]}"}
if [[ "${show_all}" -eq 1 ]]; then
    print_bucket KEEP "" ${keep[@]+"${keep[@]}"}
else
    printf '\n%s%d kept (managed, required, in use, or not movable); --all lists them%s\n' "${dim}" "${#keep[@]}" "${reset}"
fi
printf '\n%sNothing was changed. To archive entries, run ~/.dotfiles/scripts/file-review.sh --cleanup%s\n' "${dim}" "${reset}"
