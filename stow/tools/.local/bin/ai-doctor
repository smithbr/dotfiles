#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""List what to fix or trim in Claude Code, Codex, and Cursor, and fix it.

  ai-doctor             what needs doing, as a short numbered list; on a
                        terminal, then the list of [auto] items to change
  ai-doctor --fix       that list without a terminal too, read as one line
                        (--yes applies every [auto] item, asking nothing)
  ai-doctor -v          also everything checked: instructions, skills per
                        bundle and per plugin, agents, plugins with their
                        use, and MCP servers, with token sizes
  ai-doctor --app NAME  only claude, codex, or cursor (repeatable)

The summary line says where each session's load comes from: skills from the
persona's bundles and from plugins, agents, MCP servers by state (ready,
waiting for a sign-in, off, can't start), and the tokens read before you
type. It then looks for MCP servers that cannot start, secrets written into
MCP config, broken skill links, skill bundles beyond what the dotfiles
persona asks for, plugins loaded twice, plugins whose servers wait for a
sign-in, and plugins Claude Code records no use of. Each item says what to
do and what every session loses when you do it, so the setup can stay lean
and a plugin can be turned on only while it is needed. An item marked [auto]
is one --fix can do: it unlinks skill bundles with skills-add, removes or
repairs a server with the app's own command (or edits its config, after a
backup), and deletes broken links. Backups go to ~/.local/state/ai-doctor/<time>/.

Exits 1 while something is broken (not just worth trimming), otherwise 0.
Connectors kept only on claude.ai, the tools the desktop apps add themselves,
and Claude Code's built-in skills and agents are not on disk, so they are not
counted; turn connectors off in the app. Sizes are rough, about 4 characters
a token, and leave out each MCP tool's name and schema.
"""

import argparse
import json
import os
import re
import select
import shutil
import stat
import subprocess
import sys
import termios
import time
import tty
from pathlib import Path

try:
    import tomllib
except ImportError:  # Python before 3.11
    tomllib = None

APPS = ("claude", "codex", "cursor")
HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
STATE_HOME = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local" / "state")
AGENTS_DIR = CONFIG_HOME / "agents"
# The script lives at <repo>/stow/tools/.local/bin/ai-doctor, reached through its stow link.
DOTFILES_DIR = Path(os.environ.get("DOTFILES_DIR") or Path(__file__).resolve().parents[4])

SECRET_KEY = re.compile(r"token|secret|password|api[-_]?key|authorization|bearer", re.I)
SECRET_VALUE = re.compile(r"^(bearer\s+)?(gh[opsur]_|github_pat_|sk-|xox[abp]-|glpat-)", re.I)


# Output -------------------------------------------------------------------


class Finding:
    """One thing to do: broken (fix) or worth trimming (trim)."""

    def __init__(self, kind, title, todo, apply=None, effect=None):
        self.kind = kind
        self.title = title
        self.todo = todo  # one line: the command or the step
        self.apply = apply  # callable(backup_dir) -> message, when --fix can do it
        self.effect = effect  # one line: what every session loses or gains


class Report:
    def __init__(self, color, verbose):
        self.color = color
        self.verbose = verbose
        self.findings = []
        self.stats = {}
        self.plugins = {}  # name -> what it adds, filled by check_plugins

    def paint(self, code, text):
        return f"\033[{code}m{text}\033[0m" if self.color else text

    # Inventory lines show only with -v.
    def section(self, title):
        if self.verbose:
            print()
            print(self.paint("1", title))

    def line(self, text, indent=2):
        if self.verbose:
            print(" " * indent + text)

    def ok(self, text):
        self.line(f"{self.paint('32', 'ok')}  {text}")

    def note(self, text):
        self.line(f"{self.paint('2', '--')}  {text}")

    def fix(self, title, todo, apply=None, effect=None):
        self.findings.append(Finding("fix", title, todo, apply, effect))

    def trim(self, title, todo, apply=None, effect=None):
        self.findings.append(Finding("trim", title, todo, apply, effect))


def tilde(path):
    text = str(path)
    for home in (str(HOME), str(HOME.resolve())):
        if text == home or text.startswith(home + "/"):
            return "~" + text[len(home):]
    return text


def plural(count, word):
    return f"{count} {word}" if count == 1 else f"{count} {word}s"


def waits(count):
    return "waits" if count == 1 else "wait"


def tokens(chars):
    return f"~{(chars + 2) // 4:,} tokens"


def read_text(path):
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None


def read_json(path):
    text = read_text(path)
    if text is None:
        return None
    try:
        return json.loads(text)
    except ValueError:
        return None


def others_can_read(path):
    try:
        return bool(Path(path).stat().st_mode & (stat.S_IRGRP | stat.S_IROTH))
    except OSError:
        return False


# Fixes --------------------------------------------------------------------


def backup(path, backup_dir):
    """Copy path into backup_dir before changing it; the first copy, the original, is kept."""
    backup_dir.mkdir(parents=True, exist_ok=True)
    target = backup_dir / str(Path(path)).lstrip("/").replace("/", "__")
    if target.exists():
        return
    if Path(path).is_dir():
        shutil.copytree(path, target, symlinks=True)
    else:
        shutil.copy2(path, target)


def write_json(path, data):
    path = Path(path)
    tmp = path.with_name(path.name + ".ai-doctor")
    tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    os.chmod(tmp, stat.S_IMODE(path.stat().st_mode))
    os.replace(tmp, path)


def edit_json(path, change):
    """A fix that backs up a JSON file, then changes it in place."""
    def apply(backup_dir):
        data = read_json(path)
        if data is None:
            raise RuntimeError(f"cannot read {tilde(path)}")
        backup(path, backup_dir)
        change(data)
        write_json(path, data)
    return apply


def run(command):
    """A fix that runs a command."""
    def apply(_backup_dir):
        subprocess.run(command, check=True)
    return apply


def drop_toml_table(path, name):
    """A fix that removes [mcp_servers.NAME] and its sub-tables from a TOML file."""
    def apply(backup_dir):
        lines = Path(path).read_text(encoding="utf-8").splitlines(keepends=True)
        header = re.compile(r"\s*\[\s*mcp_servers\.(\"?)" + re.escape(name) + r"\1\s*(\.|\])")
        kept, skipping = [], False
        for line in lines:
            if line.lstrip().startswith("["):
                skipping = bool(header.match(line))
            if not skipping:
                kept.append(line)
        backup(path, backup_dir)
        Path(path).write_text("".join(kept), encoding="utf-8")
    return apply


# Instructions -------------------------------------------------------------


def memory_dir(cwd):
    return HOME / ".claude" / "projects" / re.sub(r"[^A-Za-z0-9]", "-", str(cwd)) / "memory"


def check_instructions(report, apps, cwd):
    report.section("Instructions (read into every session)")
    files = []
    if "claude" in apps:
        files += [("Claude global", HOME / ".claude" / "CLAUDE.md"),
                  ("Claude memory", memory_dir(cwd) / "MEMORY.md")]
    if "codex" in apps:
        files.append(("Codex global", HOME / ".codex" / "AGENTS.md"))
    for name in ("CLAUDE.md", "AGENTS.md", "CLAUDE.local.md"):
        files.append(("project", cwd / name))
    seen = {}
    total = 0
    for label, path in files:
        if not path.is_file():
            continue
        real = path.resolve()
        if real in seen:
            report.note(f"{label} {tilde(path)}: same file as {seen[real]}")
            continue
        seen[real] = label
        size = len(read_text(path) or "")
        total += size
        report.ok(f"{label} {tilde(path)}: {tokens(size)}")
    report.stats["instruction_chars"] = total
    rules = AGENTS_DIR / "rules"
    if rules.is_dir():
        size = sum(len(read_text(p) or "") for p in sorted(rules.iterdir()) if p.is_file())
        report.note(f"rules in {tilde(rules)}: {tokens(size)} when the instructions say to read them")
    if not seen:
        report.note("no instruction files found")
    elif total > 40_000:
        report.trim(f"Instruction files cost {tokens(total)} a session",
                    "shorten the largest one (ai-doctor -v lists them)")


# Skills -------------------------------------------------------------------


def frontmatter_text(skill_md):
    text = read_text(skill_md) or ""
    match = re.match(r"---\s*\n(.*?)\n---", text, re.S)
    if not match:
        return ""
    kept = []
    keep = False
    for line in match.group(1).splitlines():
        key = re.match(r"(\w[\w-]*):\s*(.*)", line)
        if key:
            keep = key.group(1) in ("name", "description")
            if keep:
                kept.append(key.group(2).strip("'\" |>"))
        elif keep and line.startswith((" ", "\t")):
            kept.append(line.strip())
    return " ".join(kept)


def bundle_of(path):
    """The agents-checkout bundle a skill links into, or where else it lives."""
    real = Path(os.path.realpath(path))
    try:
        parts = real.relative_to(AGENTS_DIR.resolve() / "skills").parts
    except ValueError:
        return "linked elsewhere" if path.is_symlink() else "local"
    return parts[0] if len(parts) > 1 else "local"


def persona_bundles():
    """Skill bundles the dotfiles persona asks for, or None without a persona."""
    name = os.environ.get("DOTFILES_PERSONA") or (read_text(STATE_HOME / "dotfiles" / "persona") or "").strip()
    text = read_text(DOTFILES_DIR / "personas" / name) if name else None
    if text is None:
        return None, None
    for line in text.splitlines():
        if line.startswith("skills="):
            return name, line.split("=", 1)[1].split()
    return name, ["core"]


def check_skills(report, apps):
    report.section("Skills (each name and description is in every session)")
    dirs = []
    if "claude" in apps:
        dirs.append(HOME / ".claude" / "skills")
    if "codex" in apps:
        dirs += [HOME / ".codex" / "skills", HOME / ".agents" / "skills"]
    if "cursor" in apps:
        dirs.append(HOME / ".cursor" / "skills")
    seen = {}
    shared = (HOME / ".agents" / "skills").resolve()
    for folder in dirs:
        if not folder.is_dir():
            continue
        real = folder.resolve()
        if real in seen:
            report.note(f"{tilde(folder)}: same folder as {tilde(seen[real])}")
            continue
        seen[real] = folder
        bundles = {}
        chars = 0
        for entry in sorted(folder.iterdir()):
            if entry.name.startswith("."):
                continue
            if entry.is_symlink() and not entry.exists():
                link = real / entry.name
                report.fix(f"Skill link {tilde(link)} is broken",
                           f"rm {tilde(link)}", lambda _b, link=link: link.unlink())
                continue
            skill_md = entry / "SKILL.md"
            if not skill_md.is_file():
                continue
            size = len(frontmatter_text(skill_md))
            chars += size
            bundles.setdefault(bundle_of(entry), []).append((entry.name, size))
        count = sum(len(v) for v in bundles.values())
        report.stats["skills"] = report.stats.get("skills", 0) + count
        report.stats["skill_chars"] = report.stats.get("skill_chars", 0) + chars
        where = f" -> {tilde(real)}" if real != folder.absolute() else ""
        report.ok(f"{tilde(folder)}{where}: {count} skills, {tokens(chars)}")
        for bundle, skills in sorted(bundles.items(), key=lambda kv: (-len(kv[1]), kv[0])):
            report.line(f"{bundle:<18} {len(skills):>3} skills  {tokens(sum(s for _, s in skills))}", 6)
        if real == shared:
            report.stats["bundles"] = len(set(bundles) - {"local", "linked elsewhere"})
            report.stats["bundle_skills"] = count
            if (AGENTS_DIR / "skills").is_dir():
                compare_persona(report, bundles)


def compare_persona(report, bundles):
    persona, wanted = persona_bundles()
    if persona is None:
        return
    linked = set(bundles) - {"local", "linked elsewhere"}
    extra = sorted(linked - set(wanted))
    missing = sorted(set(wanted) - linked)
    skills_add = AGENTS_DIR / "scripts" / "skills-add"
    if extra:
        count = sum(len(bundles[b]) for b in extra)
        chars = sum(s for b in extra for _, s in bundles[b])
        report.trim(
            f"{plural(len(extra), 'skill bundle')} beyond the {persona} persona cost {tokens(chars)} a session",
            f"skill-drop {' '.join(extra)}",
            run([str(skills_add), "-D", *extra]) if skills_add.is_file() else None,
            f"every session drops {plural(count, 'skill')} ({tokens(chars)}); skills-add brings a bundle back")
    if missing:
        report.fix(f"{plural(len(missing), 'skill bundle')} the {persona} persona asks for are not linked",
                   f"skills-add {' '.join(missing)}",
                   run([str(skills_add), *missing]) if skills_add.is_file() else None)
    if not extra and not missing:
        report.ok(f"linked bundles match the {persona} persona")


# Plugins ------------------------------------------------------------------


def agent_files(folder):
    """(name, description size) for each agent definition in a folder."""
    folder = Path(folder)
    if not folder.is_dir():
        return []
    return [(p.stem, len(frontmatter_text(p))) for p in sorted(folder.glob("*.md")) if p.is_file()]


def check_agents(report, apps, plugins):
    """Agents under ~/.claude/agents and in plugins; Claude Code's own are not on disk."""
    if "claude" not in apps:
        return
    report.section("Agents (each name and description is in every session)")
    folder = HOME / ".claude" / "agents"
    own = agent_files(folder)
    if own:
        real = folder.resolve()
        where = f" -> {tilde(real)}" if real != folder.absolute() else ""
        report.ok(f"{tilde(folder)}{where}: {plural(len(own), 'agent')}, {tokens(sum(s for _, s in own))}")
        report.line(", ".join(n for n, _ in own), 6)
    from_plugins = [(name, agent_files(Path(root) / "agents")) for name, _s, root, _k in plugins]
    from_plugins = [(name, agents) for name, agents in from_plugins if agents]
    for name, agents in from_plugins:
        report.ok(f"plugin {name}: {plural(len(agents), 'agent')}, {tokens(sum(s for _, s in agents))}")
    if not own and not from_plugins:
        report.note("none on disk; Claude Code's built-in agents are not counted")
    report.stats["agents"] = len(own) + sum(len(a) for _, a in from_plugins)
    report.stats["agent_chars"] = sum(s for _, s in own) + sum(s for _, a in from_plugins for _, s in a)


def plugin_contents(root):
    """What a plugin adds to every session: skill count and size, MCP servers, agents."""
    root = Path(root)
    skill_files = [f for p in ("SKILL.md", "skills/*/SKILL.md", "commands/*.md") for f in root.glob(p)]
    servers = (read_json(root / ".mcp.json") or {}).get("mcpServers", {})
    return {
        "skills": len(skill_files),
        "skill_chars": sum(len(frontmatter_text(f)) for f in skill_files),
        "servers": servers if isinstance(servers, dict) else {},
        "agents": len(agent_files(root / "agents")),
    }


def plugin_usage():
    """Plugin name -> (uses, days since last use, startups since) from Claude Code's own record,
    or None when it keeps none."""
    state = read_json(HOME / ".claude.json") or {}
    usage = state.get("pluginUsage")
    if not isinstance(usage, dict):
        return None
    startups = state.get("numStartups") or 0
    found = {}
    for key, record in usage.items():
        if not isinstance(record, dict):
            continue
        name = key.split("@")[0]
        uses = record.get("usageCount") or 0
        last = record.get("lastUsedAt")
        days = int((time.time() - last / 1000) // 86400) if isinstance(last, (int, float)) and last else None
        since = startups - (record.get("lastUsedNumStartups") or 0)
        if name not in found or uses > found[name][0]:
            found[name] = (uses, days, since)
    return found


def describe_usage(usage):
    if usage is None:
        return "use not recorded"
    uses, days, since = usage
    if not uses:
        return "no recorded use"
    when = f"{days} days ago" if days else "today"
    return f"used {plural(uses, 'time')}, last {when}"


def plugin_effect(contents):
    """What every session loses when a plugin is turned off."""
    parts = [f"{plural(contents['skills'], 'skill')} ({tokens(contents['skill_chars'])})"]
    if contents["servers"]:
        parts.append(plural(len(contents["servers"]), "MCP server"))
    if contents["agents"]:
        parts.append(plural(contents["agents"], "agent"))
    return "off, every session drops " + ", ".join(parts) + "; turn it back on when a task needs it"


def plugin_todo(source, key):
    if source == "installed":
        return f"claude plugin uninstall {key}"
    return "turn it off in Claude's settings (claude.ai plugins)"


def plugin_name(root):
    meta = read_json(Path(root) / ".claude-plugin" / "plugin.json") or {}
    return meta.get("name") or Path(root).name


def claude_plugins():
    """(name, source, root, install key) for every installed and synced Claude Code plugin."""
    found = []
    installed = read_json(HOME / ".claude" / "plugins" / "installed_plugins.json") or {}
    for key, entries in (installed.get("plugins") or {}).items():
        entries = [e for e in (entries if isinstance(entries, list) else [entries])
                   if isinstance(e, dict) and e.get("installPath") and Path(e["installPath"]).is_dir()]
        if entries:
            found.append((key.split("@")[0], "installed", Path(entries[-1]["installPath"]), key))
    for root in sorted((HOME / ".claude" / "plugins" / "synced").glob("*/*/.claude-plugin")):
        found.append((plugin_name(root.parent), "claude.ai", root.parent, None))
    return found


def uninstall_plugin(key, root):
    """Remove a locally installed plugin: its entry and its cached copy."""
    index = HOME / ".claude" / "plugins" / "installed_plugins.json"
    cache = HOME / ".claude" / "plugins" / "cache"

    def apply(backup_dir):
        if shutil.which("claude"):
            subprocess.run(["claude", "plugin", "uninstall", key], check=True)
            return
        edit_json(index, lambda data: data.get("plugins", {}).pop(key, None))(backup_dir)
        folder = Path(root)
        while folder.parent != cache and cache in folder.parents:
            folder = folder.parent
        if cache in folder.parents:
            shutil.move(str(folder), str(backup_dir / f"plugin-cache-{folder.name}"))
    return apply


def check_plugins(report, plugins):
    report.section("Claude Code plugins")
    report.stats["plugins"] = len(plugins)
    if not plugins:
        report.note("none installed")
        return
    usage = plugin_usage()
    sources = {}
    report.plugins = {}
    for name, source, root, key in plugins:
        contents = plugin_contents(root)
        used = (usage or {}).get(name) if usage is not None else None
        report.plugins[name] = {"source": source, "key": key, "root": root, "usage": used, **contents}
        report.stats["plugin_skills"] = report.stats.get("plugin_skills", 0) + contents["skills"]
        report.stats["plugin_skill_chars"] = report.stats.get("plugin_skill_chars", 0) + contents["skill_chars"]
        extra = f", {plural(len(contents['servers']), 'MCP server')}" if contents["servers"] else ""
        extra += f", {plural(contents['agents'], 'agent')}" if contents["agents"] else ""
        report.ok(f"{name} ({source}): {plural(contents['skills'], 'skill')} ({tokens(contents['skill_chars'])})"
                  f"{extra}; {describe_usage(used if usage is not None else None)}")
        sources.setdefault(name, {})[source] = (key, root)
    for name, found in sorted(sources.items()):
        if "installed" in found and "claude.ai" in found:
            key, root = found["installed"]
            contents = plugin_contents(root)
            report.trim(f"Plugin {name} loads twice: installed here and synced from claude.ai",
                        f"claude plugin uninstall {key}", uninstall_plugin(key, root),
                        f"every session drops the duplicate's {plural(contents['skills'], 'skill')} "
                        f"({tokens(contents['skill_chars'])}); the claude.ai copy stays")


def unused_plugins(report, flagged):
    """Plugins Claude Code records no use of, beyond those already flagged."""
    for name, info in sorted(report.plugins.items()):
        if name in flagged or info["usage"] is None or info["usage"][0]:
            continue
        apply = uninstall_plugin(info["key"], info["root"]) if info["source"] == "installed" else None
        report.trim(f"Plugin {name} has no recorded use", plugin_todo(info["source"], info["key"]),
                    apply, plugin_effect(info))


# MCP servers --------------------------------------------------------------


def toml_servers(path):
    if not path.is_file():
        return {}
    if tomllib is None:
        return None
    try:
        with path.open("rb") as handle:
            return tomllib.load(handle).get("mcp_servers", {})
    except (OSError, ValueError):
        return {}


def collect_servers(apps, cwd, plugins):
    """(app, file, scope, name, config) for every MCP server the apps would start."""
    servers = []
    if "claude" in apps:
        state_file = HOME / ".claude.json"
        state = read_json(state_file) or {}
        for name, conf in (state.get("mcpServers") or {}).items():
            servers.append(("claude", state_file, "user", name, conf))
        project = (state.get("projects") or {}).get(str(cwd)) or {}
        for name, conf in (project.get("mcpServers") or {}).items():
            servers.append(("claude", state_file, "local", name, conf))
        for name, conf in ((read_json(cwd / ".mcp.json") or {}).get("mcpServers") or {}).items():
            servers.append(("claude", cwd / ".mcp.json", "project", name, conf))
        for plugin, _source, root, _key in plugins:
            for name, conf in plugin_contents(root)["servers"].items():
                servers.append(("claude", root / ".mcp.json", f"plugin {plugin}", f"plugin:{plugin}:{name}", conf))
    if "codex" in apps:
        config = HOME / ".codex" / "config.toml"
        codex = toml_servers(config)
        if codex is None:
            servers.append(("codex", config, "user", None, None))
        for name, conf in (codex or {}).items():
            servers.append(("codex", config, "user", name, conf))
    if "cursor" in apps:
        for path in (HOME / ".cursor" / "mcp.json", cwd / ".cursor" / "mcp.json"):
            for name, conf in ((read_json(path) or {}).get("mcpServers") or {}).items():
                servers.append(("cursor", path, "user", name, conf))
    return servers


def literal_secrets(conf):
    """Names of headers and env values that hold a secret written out, not a variable."""
    found = []
    for field in ("headers", "env", "http_headers"):
        values = conf.get(field)
        if not isinstance(values, dict):
            continue
        for key, value in values.items():
            if not isinstance(value, str) or not value.strip() or "$" in value:
                continue
            if SECRET_KEY.search(key) or SECRET_VALUE.search(value):
                found.append((field, key))
    return found


def server_problem(conf):
    """Why a server cannot start, or None."""
    command = conf.get("command")
    if isinstance(command, str) and command:
        if re.match(r"https?://", command):
            return "url"
        if "/" in command or command.startswith("~"):
            path = Path(os.path.expanduser(command))
            if not (path.is_file() and os.access(path, os.X_OK)):
                return f"{command} is missing"
        elif shutil.which(command) is None:
            return f"{command} is not installed"
        for arg in conf.get("args") or []:
            if isinstance(arg, str) and arg.startswith(("/", "~/")) and not Path(os.path.expanduser(arg)).exists():
                return f"{arg} is missing"
        return None
    if not (conf.get("url") or conf.get("serverUrl")):
        return "it has neither a command nor a url"
    return None


def json_servers_path(app, scope, cwd):
    if app == "claude" and scope == "local":
        return ["projects", str(cwd), "mcpServers"]
    return ["mcpServers"]


def pop_server(keys, name):
    def change(data):
        for key in keys:
            data = data.get(key, {})
        data.pop(name, None)
    return change


def remove_server(app, file, scope, name, cwd):
    """(todo, apply) that removes a server from its app's config."""
    if app == "claude":
        todo = f"claude mcp remove {name} -s {scope}"
        if shutil.which("claude"):
            return todo, run(["claude", "mcp", "remove", name, "-s", scope])
        return todo, edit_json(file, pop_server(json_servers_path(app, scope, cwd), name))
    if app == "codex":
        if shutil.which("codex"):
            return f"codex mcp remove {name}", run(["codex", "mcp", "remove", name])
        return f"delete [mcp_servers.{name}] from {tilde(file)}", drop_toml_table(file, name)
    return f"delete \"{name}\" from {tilde(file)}", edit_json(file, pop_server(["mcpServers"], name))


def command_to_url(file, name):
    def change(data):
        conf = data["mcpServers"][name]
        conf["url"] = conf.pop("command")
        conf.pop("args", None)
    return edit_json(file, change)


def secret_todo(app, file, field, key):
    var = "MCP_TOKEN" if key.lower() == "authorization" else re.sub(r"[^A-Z0-9]", "_", key.upper())
    ref = {"claude": f"${{{var}}}", "cursor": f"${{env:{var}}}"}.get(app)
    if ref is None:
        return f"rotate it, then name an environment variable instead (bearer_token_env_var = \"{var}\")"
    prefix = "Bearer " if key.lower() == "authorization" else ""
    return f"rotate it, set {field}.{key} to \"{prefix}{ref}\", and export {var} from your shell startup"


def check_servers(report, apps, cwd, plugins):
    report.section("MCP servers (each one's tool names are in every session)")
    needs_auth = read_json(HOME / ".claude" / "mcp-needs-auth-cache.json") or {}
    waiting = {}
    seen = set()
    states = report.stats.setdefault("server_states", {})

    def count(state):
        states[state] = states.get(state, 0) + 1

    for app, file, scope, name, conf in collect_servers(apps, cwd, plugins):
        if name is None:
            report.note(f"{app}: {tilde(file)} needs Python 3.11 to read; skipped")
            continue
        if (app, name) in seen or not isinstance(conf, dict):
            continue
        seen.add((app, name))
        report.stats["servers"] = report.stats.get("servers", 0) + 1
        label = f"{app}: {name}"
        if conf.get("enabled") is False or conf.get("disabled") is True:
            count("disabled")
            report.note(f"{label}: turned off")
            continue
        if conf.get("type") in ("http", "sse") and not conf.get("url") and not conf.get("command"):
            count("ready")
            report.note(f"{label}: a claude.ai connector fills in its url")
            continue
        problem = server_problem(conf)
        plugin = scope[7:] if scope.startswith("plugin ") else None
        if problem:
            count("can't start")
        elif app == "claude" and name in needs_auth:
            count("wait for a sign-in")
        else:
            count("ready")
        if problem and plugin:
            report.note(f"{label}: {problem}; the {plugin} plugin ships it that way")
        elif problem == "url":
            report.fix(f"{app.capitalize()}'s {name} MCP server can't start: its URL is in \"command\"",
                       f"in {tilde(file)}, rename \"command\" to \"url\"",
                       command_to_url(file, name) if app == "cursor" or file.suffix == ".json" else None)
        elif problem:
            todo, apply = remove_server(app, file, scope, name, cwd)
            report.fix(f"{app.capitalize()}'s {name} MCP server can't start: {problem}", todo, apply)
        elif app == "claude" and name in needs_auth and plugin:
            waiting.setdefault(plugin, []).append(name)
        elif app == "claude" and name in needs_auth:
            todo, apply = remove_server(app, file, scope, name, cwd)
            report.note(f"{label} ({scope}): waiting for a sign-in")
            report.trim(f"Claude's {name} MCP server ({scope}) waits for a sign-in",
                        f"sign in with /mcp, or: {todo}", apply,
                        "its tool names stay in every session until then; claude mcp add brings it back")
        else:
            report.ok(f"{label} ({scope}): {'remote' if conf.get('url') or conf.get('serverUrl') else 'local'}")
        for field, key in literal_secrets(conf):
            title = f"{app.capitalize()}'s {name} MCP server has a token written into {tilde(file)}"
            if others_can_read(file):
                report.fix(title + ", and other users can read the file", f"chmod 600 {tilde(file)}",
                           lambda _b, file=file: os.chmod(file, 0o600))
            report.fix(title, secret_todo(app, tilde(file), field, key))
    for where, names in waiting.items():
        short = ", ".join(n.rsplit(":", 1)[-1] for n in names)
        report.note(f"waiting for sign-in in plugin {where}: {short}")
        info = report.plugins.get(where)
        if info is None:
            report.trim(f"Plugin {where}: {short} {waits(len(names))} for a sign-in",
                        "sign in with /mcp, or turn the plugin off in Claude's settings",
                        effect="each one's tool names stay in every session until then")
            continue
        report.trim(f"Plugin {where}: {short} ({len(names)} of {plural(len(info['servers']), 'MCP server')}) "
                    f"{waits(len(names))} for a sign-in; {describe_usage(info['usage'])}",
                    f"sign in with /mcp, or {plugin_todo(info['source'], info['key'])}",
                    uninstall_plugin(info["key"], info["root"]) if info["source"] == "installed" else None,
                    plugin_effect(info))
    unused_plugins(report, set(waiting))


# Settings -----------------------------------------------------------------


def check_settings(report):
    report.section("Claude Code settings")
    settings = read_json(HOME / ".claude" / "settings.json") or {}
    env = settings.get("env") or {}
    for flag in sorted(k for k, v in env.items() if "EXPERIMENTAL" in k and str(v) not in ("", "0", "false")):
        report.note(f"{flag} is on in ~/.claude/settings.json")
    if settings.get("outputStyle"):
        report.note(f"output style: {settings['outputStyle']}")
    if settings.get("agent"):
        report.note(f"every session starts as the {settings['agent']} agent")


# Main ---------------------------------------------------------------------


def installed_apps():
    return [app for app in APPS if (HOME / f".{app}").is_dir()]


def summary(report, apps):
    """One line: where every session's load comes from and what it costs."""
    stats = report.stats
    parts = [", ".join(apps)]
    if "skills" in stats:
        skills = f"{stats['skills']} skills"
        if stats.get("bundles"):
            local = stats["skills"] - stats["bundle_skills"]
            skills = f"{stats['bundle_skills']} skills from {plural(stats['bundles'], 'bundle')}"
            skills += f" + {local} local" if local else ""
        if stats.get("plugin_skills"):
            skills += f" + {stats['plugin_skills']} from {plural(stats['plugins'], 'plugin')}"
        elif "plugins" in stats:
            skills += f" · {plural(stats['plugins'], 'plugin')}"
        parts.append(skills)
    elif "plugins" in stats:
        parts.append(plural(stats["plugins"], "plugin"))
    if stats.get("agents"):
        parts.append(plural(stats["agents"], "agent"))
    if "servers" in stats:
        states = ", ".join(f"{n} {state}" for state, n in stats.get("server_states", {}).items()
                           if state != "ready" and n)
        parts.append(plural(stats["servers"], "MCP server") + (f" ({states})" if states else ""))
    load = sum(stats.get(k, 0) for k in ("instruction_chars", "skill_chars", "plugin_skill_chars", "agent_chars"))
    if load:
        parts.append(f"{tokens(load)} before you type")
    return " · ".join(parts)


def print_findings(report):
    findings = sorted(report.findings, key=lambda f: f.kind != "fix")
    print()
    if not findings:
        print(f"  {report.paint('32', 'Nothing to do.')}")
        return findings
    for number, finding in enumerate(findings, 1):
        mark = report.paint("31", "fix ") if finding.kind == "fix" else report.paint("33", "trim")
        auto = report.paint("2", "  [auto]") if finding.apply else ""
        print(f"  {number:>2}  {mark}  {finding.title}")
        print(f"            {report.paint('36', finding.todo)}{auto}")
        if finding.effect:
            print(f"            {report.paint('2', finding.effect)}")
    return findings


def stdin_closed():
    try:
        return os.path.samestat(os.fstat(0), os.stat(os.devnull))
    except OSError:
        return True


def tally(actions):
    count = actions.count("fix")
    return f"fix {count}" if count else "nothing changes"


def pick_on_terminal(report, rows, actions):
    """The list on the alternate screen, df-doctor's way: the arrows choose a
    row, f or s (or space) sets it, Enter applies every row, q or Esc cancels.
    Returns the actions, or None when cancelled."""
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    out = sys.stderr
    picked = list(actions)
    cursor = top = 0
    note = ""
    head = "f fix (do the [auto] step)  s skip (leave it)"
    keys = "↑↓ PgUp PgDn Home End choose a row  space next change  enter apply all  q cancel"

    def key():
        return os.read(fd, 1)

    def waiting():
        return bool(select.select([fd], [], [], 0.1)[0])

    try:
        tty.setcbreak(fd, termios.TCSANOW)
        out.write("\033[?1049h\033[?25l")
        while True:
            cols, lines = shutil.get_terminal_size()
            cols = cols if cols >= 20 else 80
            # Three lines above the rows and three below.
            height = max(lines - 7, 3)
            top = min(top, cursor)
            top = max(top, cursor - height + 1)
            last = min(top + height, len(rows))
            screen = ["\033[H\033[2J" + report.paint("1", "Choose a change for each item") + f" ({len(rows)})",
                      head[:cols], report.paint("2", keys[:cols])]
            for r in range(top, last):
                number, finding = rows[r]
                text = f"{picked[r]:<4} {number:>2}  {finding.todo}"[:cols - 2]
                screen.append(report.paint("1", f"> {text}") if r == cursor else f"  {text}")
            screen += [""] * (height - (last - top))
            foot = report.paint("2", f"{top + 1}-{last} of {len(rows)}") + "  " if len(rows) > height else ""
            foot += report.paint("33", note) if note else f"Enter: {tally(picked)}"
            finding = rows[cursor][1]
            screen += [foot, report.paint("1", f"{finding.kind}: {finding.title}"[:cols]),
                       report.paint("2", (finding.effect or "")[:cols])]
            out.write("\n".join(screen))
            out.flush()
            note = ""
            pressed = key()
            if pressed == b"\033":
                rest = os.read(fd, 2) if waiting() else b""
                if rest == b"[A":
                    cursor = max(cursor - 1, 0)
                elif rest == b"[B":
                    cursor = min(cursor + 1, len(rows) - 1)
                elif rest in (b"[H", b"OH"):
                    cursor = 0
                elif rest in (b"[F", b"OF"):
                    cursor = len(rows) - 1
                elif rest in (b"[5", b"[6"):
                    if waiting():
                        key()
                    step = -height if rest == b"[5" else height
                    cursor = min(max(cursor + step, 0), len(rows) - 1)
                else:
                    return None
            elif pressed == b" ":
                picked[cursor] = "skip" if picked[cursor] == "fix" else "fix"
            elif pressed in (b"f", b"s"):
                picked[cursor] = "fix" if pressed == b"f" else "skip"
            elif pressed in (b"\n", b"\r"):
                return picked
            elif pressed in (b"q", b""):
                return None
            else:
                note = "f fixes the row, s skips it"
    except KeyboardInterrupt:
        raise SystemExit(130)
    finally:
        out.write("\033[?25h\033[?1049l")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def pick_by_line(rows, actions):
    """The list without a terminal (or with DOTFILES_PROMPT=read): the rows,
    then one line of actions and item numbers. Returns None on a line it
    cannot use, changing no row."""
    numbers = [number for number, _ in rows]
    print("Choose a change for each item:", file=sys.stderr)
    for (number, finding), action in zip(rows, actions):
        print(f"  {number:>2}) {action:<4} {finding.todo}", file=sys.stderr)
    print('Actions then item numbers, like "fix 2 5-7 skip 3"; none skips everything; '
          "Enter applies the list as shown: ", end="", file=sys.stderr, flush=True)
    try:
        reply = input()
    except EOFError:
        print(file=sys.stderr)
        return None
    picked = list(actions)
    action = None
    for token in reply.split():
        if token == "none":
            picked = ["skip"] * len(picked)
            continue
        if token in ("fix", "skip"):
            action = token
            continue
        match = re.fullmatch(r"(\d{1,6})(?:-(\d{1,6}))?", token)
        if not action or not match:
            print(f"Not understood: {token}; nothing changed", file=sys.stderr)
            return None
        low, high = int(match[1]), int(match[2] or match[1])
        hits = [r for r, number in enumerate(numbers) if low <= number <= high]
        if not hits:
            print(f"No [auto] item {token}; nothing changed", file=sys.stderr)
            return None
        for r in hits:
            picked[r] = action
    return picked


def apply_findings(report, findings, yes):
    """One list of every [auto] item, a fix set to fix and a trim to skip; the
    person changes any row and every row is applied at once. Nothing changes
    when the list is cancelled or stdin is closed."""
    rows = [(n, f) for n, f in enumerate(findings, 1) if f.apply]
    if not rows:
        print("\n  Nothing here can be fixed automatically; each item above says what to do.")
        return
    if yes:
        actions = ["fix"] * len(rows)
    else:
        if stdin_closed():
            print("\n  Nothing changed: ai-doctor asks before changing anything, and stdin is closed.")
            return
        actions = ["fix" if f.kind == "fix" else "skip" for _, f in rows]
        print(file=sys.stderr)
        if os.environ.get("DOTFILES_PROMPT") != "read" and sys.stdin.isatty() and sys.stderr.isatty():
            actions = pick_on_terminal(report, rows, actions)
        else:
            actions = pick_by_line(rows, actions)
        if actions is None or "fix" not in actions:
            print("  Nothing changed.")
            return
    backup_dir = STATE_HOME / "ai-doctor" / time.strftime("%Y%m%d-%H%M%S")
    done = failed = 0
    print()
    for (number, finding), action in zip(rows, actions):
        if action != "fix":
            continue
        try:
            finding.apply(backup_dir)
        except (OSError, RuntimeError, KeyError, subprocess.CalledProcessError) as error:
            print(f"  {number:>2}  {finding.todo}: {report.paint('31', 'failed')}: {error}")
            failed += 1
            continue
        finding.done = True
        done += 1
        print(f"  {number:>2}  {finding.todo}: {report.paint('32', 'done')}")
    if backup_dir.exists():
        print(f"\n  Backups: {tilde(backup_dir)}")
    if failed:
        print(f"\n  Done with problems: {done} fixed, {failed} failed.")
    else:
        print(f"\n  Done: {done} fixed.")


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="ai-doctor",
        description=__doc__.split("\n", 1)[0],
        epilog=__doc__.split("\n", 1)[1],
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--fix", action="store_true", help="choose which [auto] items to do, even without a terminal")
    parser.add_argument("--yes", action="store_true", help="with --fix, apply them all without asking")
    parser.add_argument("-v", "--verbose", action="store_true", help="also list everything checked")
    parser.add_argument("--app", action="append", choices=APPS, help="check only this app (repeatable)")
    parser.add_argument("--no-color", action="store_true", help="plain output")
    args = parser.parse_args(argv)

    apps = args.app or installed_apps()
    if not apps:
        print("ai-doctor: no Claude Code, Codex, or Cursor config in this home directory")
        return 0
    color = sys.stdout.isatty() and not args.no_color and not os.environ.get("NO_COLOR")
    report = Report(color, args.verbose)
    cwd = Path.cwd()

    plugins = claude_plugins() if "claude" in apps else []
    check_instructions(report, apps, cwd)
    check_skills(report, apps)
    check_agents(report, apps, plugins)
    if "claude" in apps:
        check_plugins(report, plugins)
    check_servers(report, apps, cwd, plugins)
    if "claude" in apps:
        check_settings(report)

    if args.verbose:
        print()
    print(report.paint("1", f"ai-doctor: {summary(report, apps)}"))
    findings = print_findings(report)
    # On a terminal the list follows the report, as in df-doctor.
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    if findings and (args.fix or interactive):
        apply_findings(report, findings, args.fix and args.yes)
        return 1 if any(f.kind == "fix" and not getattr(f, "done", False) for f in findings) else 0
    auto = [str(n) for n, f in enumerate(findings, 1) if f.apply]
    if auto:
        print(f"\n  Run {report.paint('1', 'ai-doctor --fix')} to do {', '.join(auto)} (lists them to choose from). "
              "-v shows everything checked.")
    return 1 if any(f.kind == "fix" for f in findings) else 0


if __name__ == "__main__":
    sys.exit(main())
