#!/usr/bin/env bash
# Bring other machines' dotfiles up to date after pushing from this one: pull, relink, and
# reinstall the root-owned ph-agent-setup copy where one is installed and the repo's changed.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: df-deploy [-n|--dry-run] [HOST...]

Over SSH, on each HOST in turn: pull ~/.dotfiles (fast-forward only) and run
scripts/link.sh. Where /usr/local/bin/ph-agent-setup is installed and differs from
the repo's copy, also run 'ph-agent-setup user', which asks for sudo.

With no HOST, updates the hosts in $DF_DEPLOY_HOSTS (space-separated).

  -n, --dry-run   Print the ssh command for each host instead of running it
  -h, --help      Show this help
EOF
}

# Follow the stow symlink chain without GNU readlink -f, which macOS lacks.
resolve_script_path() {
    local path="${1}" dir target
    while [[ -L "${path}" ]]; do
        dir="$(cd -P "$(dirname "${path}")" && pwd)"
        target="$(readlink "${path}")"
        case "${target}" in
            /*) path="${target}" ;;
            *) path="${dir}/${target}" ;;
        esac
    done
    printf '%s/%s\n' "$(cd -P "$(dirname "${path}")" && pwd)" "$(basename "${path}")"
}

# Other machines pull from origin, so commits this checkout hasn't pushed won't reach them.
warn_unpushed() {
    local repo ahead
    # The script lives at <repo>/stow/personal/.local/bin/df-deploy.
    repo="$(cd "$(dirname "$(resolve_script_path "${BASH_SOURCE[0]}")")/../../../.." && pwd)"
    git -C "${repo}" rev-parse --git-dir >/dev/null 2>&1 || return 0
    ahead="$(git -C "${repo}" rev-list --count '@{upstream}..HEAD' 2>/dev/null)" || return 0
    if [[ "${ahead}" -gt 0 ]]; then
        printf 'df-deploy: warning: %s commit(s) here are not pushed; other machines will not get them\n' \
            "${ahead}" >&2
    fi
}

# Runs on each host. PH_AGENT_BIN_DIR matches ph-agent-setup's own override.
remote_script() {
    cat <<'EOF'
set -euo pipefail
repo="${HOME}/.dotfiles"
installed="${PH_AGENT_BIN_DIR:-/usr/local/bin}/ph-agent-setup"
repo_copy="${repo}/stow/server.linux/.local/bin/ph-agent-setup"
git -C "${repo}" pull --ff-only --quiet
printf '==> %s at %s\n' "$(hostname)" "$(git -C "${repo}" log -1 --format='%h %s')"
"${repo}/scripts/link.sh"
if [[ ! -e "${installed}" ]]; then
    :
elif cmp -s "${repo_copy}" "${installed}"; then
    printf '==> ph-agent-setup is up to date\n'
else
    printf '==> ph-agent-setup changed; reinstalling (sudo)\n'
    "${repo_copy}" user
fi
EOF
}

main() {
    local dry_run=0 command host failed=0
    local -a hosts=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--dry-run) dry_run=1 ;;
            -h|--help) usage; return 0 ;;
            -*) printf 'df-deploy: unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
            *) hosts+=("$1") ;;
        esac
        shift
    done
    if [[ "${#hosts[@]}" -eq 0 ]]; then
        read -r -a hosts <<< "${DF_DEPLOY_HOSTS:-}"
    fi
    if [[ "${#hosts[@]}" -eq 0 ]]; then
        printf 'df-deploy: name a host, or set DF_DEPLOY_HOSTS\n' >&2
        usage >&2
        exit 2
    fi

    # ssh hands the remote login shell one string; bash -c keeps the script in bash there.
    command="bash -c $(printf '%q' "$(remote_script)")"
    if [[ "${dry_run}" -eq 1 ]]; then
        for host in "${hosts[@]}"; do
            printf 'ssh -t %s %s\n' "${host}" "${command}"
        done
        return 0
    fi
    warn_unpushed
    for host in "${hosts[@]}"; do
        # -t gives the sudo prompt a terminal. One host failing doesn't stop the rest.
        if ! ssh -t "${host}" "${command}"; then
            printf 'df-deploy: %s failed\n' "${host}" >&2
            failed=1
        fi
    done
    return "${failed}"
}

main "$@"
