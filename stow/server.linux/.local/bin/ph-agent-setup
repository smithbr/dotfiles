#!/usr/bin/env bash
# ============================================================
#  ph-agent-setup — Locked-down agent user and vault importer
# ============================================================

set -euo pipefail

AGENT_USER="${PH_AGENT_USER:-agent}"
AGENT_HOME="${PH_AGENT_HOME:-/home/${AGENT_USER}}"
ADMIN_USER="${PH_AGENT_ADMIN_USER:-pi}"
VAULT_NAME="${PH_AGENT_VAULT_NAME:-blife}"
VAULT_DIR="${PH_AGENT_VAULT_DIR:-${HOME}/blife}"
VAULT_REPO="${PH_AGENT_VAULT_REPO:-git/vault.git}"
TOOLS_DIR="${PH_AGENT_TOOLS_DIR:-${HOME}/.local/share/blife-tools}"
STATE_DIR="${PH_AGENT_STATE_DIR:-${HOME}/.local/state/blife-import}"
CONFIG_DIR="${PH_AGENT_CONFIG_DIR:-${HOME}/.config/blife-import}"
DEVICE_NAME="${PH_AGENT_DEVICE_NAME:-zbox-agent}"
CRON_SCHEDULE="${PH_AGENT_CRON:-0 7 * * *}"
NODE_MAJOR="${PH_AGENT_NODE_MAJOR:-22}"
OB_VERSION="${PH_AGENT_OB_VERSION:-0.0.14}"
# Root-owned homes for what agent runs but must never be able to change: this script (run
# by agent's cron) and the vault-lint/vault-mv wrappers the import may call.
BIN_DIR="${PH_AGENT_BIN_DIR:-/usr/local/bin}"
AGENT_KEYS_DIR="/etc/ssh/authorized_keys"
SSHD_DROPIN="/etc/ssh/sshd_config.d/ph-agent-setup.conf"
RO_KEY="${HOME}/.ssh/vault_ro"
CRON_TAG="# ph-agent-setup import"

usage() {
    local help_text

    help_text="$(cat <<'EOF'
# ph-agent-setup

Set up the locked-down `agent` user on the Pi-hole box and run the daily blife `_imports/` and `_captures/` import.

## Steps, in order

| Command | Run as | Does |
|---------|--------|------|
| `user` | pi (sudo) | Create `agent` with a mode-700 home; let pi's personal SSH keys log in as agent through a root-owned key file; install this script, `vault-lint`, `vault-mv`, and `vault-cp` root-owned in `/usr/local/bin` |
| `install` | agent | Node (checksum-verified), `obsidian-headless`, Claude Code, a read-only vault key |
| `authorize` | pi (sudo, or the key on stdin) | Let agent's key fetch `~/git/vault.git` and nothing else |
| `link` | agent | Sync the vault to `~/blife` (runs `ob login` if needed), check out `.scripts/` read-only |
| `schedule` | agent | Install the daily cron job |
| `import` | agent (or pi, which switches to agent) | One import run: sync, import `_imports/` and `_captures/` as the importer role, sync |
| `status` | agent (or pi, which switches to agent) | Show versions, sync state, cron entry, and imports and captures counts |
| `sync` | agent (or pi, which switches to agent) | Sync the vault now, then show `status` |

The import calls `vault-lint ARGS` (`ph-agent-setup lint ARGS`), `vault-mv SRC DEST`
(`ph-agent-setup mv SRC DEST`, a move that stays inside the vault), and `vault-cp SRC DEST`
(`ph-agent-setup cp SRC DEST`, a copy that stays inside the vault).

## Options

| Option | Description |
|--------|-------------|
| `-h`, `--help` | Show this help |

Every step is safe to re-run.
EOF
)"

    if command -v gum >/dev/null 2>&1 && [[ -t 1 ]]; then
        printf '%s\n' "${help_text}" | gum format
        return
    fi

    cat <<'EOF'
Usage:
  ph-agent-setup user|install|authorize|link|schedule|import|status|sync
  ph-agent-setup lint [ARGS...] | mv SRC DEST | cp SRC DEST
  ph-agent-setup --help

Set up the locked-down agent user on the Pi-hole box and run the daily blife
_imports/ and _captures/ import. Run the steps in order: user (as pi, uses sudo), install
(as agent), authorize (as pi), link, schedule (as agent). Every step is safe
to re-run. lint, mv, and cp back the vault-lint, vault-mv, and vault-cp commands the
import uses.
EOF
}

log() { printf '==> %s\n' "$*"; }
die() { printf 'ph-agent-setup: %s\n' "$*" >&2; exit 1; }

require_linux() {
    [[ "$(uname -s)" == "Linux" ]] || die "runs only on the Linux Pi-hole box"
}

require_user() {
    [[ "$(id -un)" == "${1}" ]] || die "run '${2}' as ${1} (you are $(id -un))"
}

require_not_user() {
    [[ "$(id -un)" != "${1}" ]] || die "run '${2}' as the admin user, not ${1}"
}

# The root-owned wrappers come first so nothing agent can write shadows them.
use_local_bin() {
    PATH="${BIN_DIR}:${HOME}/.local/bin:${PATH}"
    export PATH
}

# ---- user: as pi, with sudo -------------------------------------------------

# Agent's authorized_keys must not be writable by agent: a prompt-injected import could
# otherwise add a key and log in without Claude's permission rules. StrictModes accepts a
# root-owned file only when every directory above it is root-owned too, and agent needs to
# write its own ~/.ssh (key, config, known_hosts), so sshd reads agent's keys from
# /etc/ssh/authorized_keys/agent instead; the old ~/.ssh/authorized_keys is then ignored.
install_agent_keys() {
    local src="${HOME}/.ssh/authorized_keys" dropin current
    [[ -r "${src}" ]] || die "no ${src} to copy personal keys from"
    sudo install -d -m 755 -o root -g root "${AGENT_KEYS_DIR}"
    # Personal keys only: a line with options (restrict, command=, from=), such as the vault
    # push key, stays with pi.
    { grep -E '^(ssh-ed25519|ssh-rsa|ecdsa-sha2-[^ ]+|sk-[^ ]+) ' "${src}" || true; } \
        | sudo install -m 644 -o root -g root /dev/stdin "${AGENT_KEYS_DIR}/${AGENT_USER}"

    dropin="$(printf '# Written by ph-agent-setup: agent cannot change its own login keys.\nMatch User %s\n    AuthorizedKeysFile %s/%%u\n' \
        "${AGENT_USER}" "${AGENT_KEYS_DIR}")"
    current="$(cat "${SSHD_DROPIN}" 2>/dev/null || true)"
    if [[ "${current}" != "${dropin}" ]]; then
        log "pointing sshd at ${AGENT_KEYS_DIR}/${AGENT_USER} for ${AGENT_USER}"
        printf '%s\n' "${dropin}" | sudo install -m 644 -o root -g root /dev/stdin "${SSHD_DROPIN}"
        if ! sudo sshd -t; then
            sudo rm -f -- "${SSHD_DROPIN}"
            die "sshd rejected ${SSHD_DROPIN}; removed it and left sshd unchanged"
        fi
        sudo systemctl reload ssh
    fi
    current="$(sudo sshd -T -C "user=${AGENT_USER},host=localhost,addr=127.0.0.1")" \
        || die "could not read the effective sshd configuration"
    grep -qixF "authorizedkeysfile ${AGENT_KEYS_DIR}/%u" <<< "${current}" \
        || die "sshd ignores ${SSHD_DROPIN}; check that sshd_config includes sshd_config.d/*.conf"
}

install_commands() {
    local cmd
    sudo install -d -m 755 -o root -g root "${BIN_DIR}"
    sudo install -m 755 -o root -g root "${BASH_SOURCE[0]}" "${BIN_DIR}/ph-agent-setup"
    for cmd in lint mv cp; do
        printf '#!/usr/bin/env bash\nexec %q %s "$@"\n' "${BIN_DIR}/ph-agent-setup" "${cmd}" \
            | sudo install -m 755 -o root -g root /dev/stdin "${BIN_DIR}/vault-${cmd}"
    done
    # Earlier versions left agent-owned copies here; they would shadow the root-owned ones.
    sudo rm -f -- "${AGENT_HOME}/.local/bin/ph-agent-setup" "${AGENT_HOME}/.local/bin/vault-lint"
}

step_user() {
    require_not_user "${AGENT_USER}" user
    # The installed copy can come first on PATH in a shell opened before the dotfiles were
    # linked; installing it over itself fails and never picks up the repo's version.
    if [[ "${BASH_SOURCE[0]}" -ef "${BIN_DIR}/ph-agent-setup" ]]; then
        die "this is the installed copy in ${BIN_DIR}; run the repo's: ~/.local/bin/ph-agent-setup user"
    fi
    if id "${AGENT_USER}" >/dev/null 2>&1; then
        log "user ${AGENT_USER} exists"
    else
        log "creating ${AGENT_USER} (no password, SSH keys only)"
        sudo adduser --disabled-password --gecos "" "${AGENT_USER}"
    fi
    sudo chmod 700 "${AGENT_HOME}"
    sudo install -d -m 700 -o "${AGENT_USER}" -g "${AGENT_USER}" \
        "${AGENT_HOME}/.ssh" "${AGENT_HOME}/.local" "${AGENT_HOME}/.local/bin"
    install_agent_keys
    install_commands
    local next
    next="$(next_setup_step)"
    if [[ -n "${next}" ]]; then
        log "done. Next, ${next}"
    else
        log "done. ${AGENT_USER} was already set up; nothing else to run"
    fi
}

# The first later step that hasn't run yet, as "as USER: ph-agent-setup STEP", or nothing
# when all have. Each step leaves a marker; agent's home is closed to pi, so look with sudo.
next_setup_step() {
    local tools="${PH_AGENT_TOOLS_DIR:-${AGENT_HOME}/.local/share/blife-tools}"
    if ! sudo test -x "${AGENT_HOME}/.local/bin/claude"; then
        printf 'as %s: ph-agent-setup install\n' "${AGENT_USER}"
    elif ! grep -qs 'agent-vault-ro$' "${HOME}/.ssh/authorized_keys"; then
        printf 'as %s: ph-agent-setup authorize\n' "${ADMIN_USER}"
    elif ! sudo test -d "${tools}/.git"; then
        printf 'as %s: ph-agent-setup link\n' "${AGENT_USER}"
    elif ! sudo crontab -u "${AGENT_USER}" -l 2>/dev/null | grep -qF "${CRON_TAG}"; then
        printf 'as %s: ph-agent-setup schedule\n' "${AGENT_USER}"
    fi
}

# ---- install: as agent -------------------------------------------------------

install_node() {
    local version file arch url
    arch="$(uname -m)"
    case "${arch}" in
        x86_64) arch="x64" ;;
        aarch64) arch="arm64" ;;
        *) die "no Node build for ${arch}" ;;
    esac
    version="$(curl -fsSL https://nodejs.org/dist/index.json | python3 -c \
        "import json,sys; print(next(r['version'] for r in json.load(sys.stdin) if r['version'].startswith('v${NODE_MAJOR}.')))")"
    if [[ "$(node -v 2>/dev/null || true)" == "${version}" ]]; then
        log "node ${version} already installed"
        return
    fi
    file="node-${version}-linux-${arch}.tar.xz"
    url="https://nodejs.org/dist/${version}"
    log "installing node ${version}"
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL -o "${tmp}/${file}" "${url}/${file}"
    # This checks the download against SHASUMS256.txt from the same host over TLS, which
    # catches corruption but not a compromised nodejs.org. Checking SHASUMS256.txt.asc would
    # need the Node release team's signing keys pinned here and kept current.
    curl -fsSL "${url}/SHASUMS256.txt" | grep " ${file}\$" | (cd "${tmp}" && sha256sum -c -)
    mkdir -p "${HOME}/.local/opt" "${HOME}/.local/bin"
    tar -xJf "${tmp}/${file}" -C "${HOME}/.local/opt"
    rm -rf "${tmp}"
    ln -sfn "${HOME}/.local/opt/node-${version}-linux-${arch}" "${HOME}/.local/opt/node"
    local b
    for b in node npm npx; do
        ln -sf "${HOME}/.local/opt/node/bin/${b}" "${HOME}/.local/bin/${b}"
    done
}

install_claude() {
    local installer
    # Download the installer completely before running it, so a dropped connection cannot
    # run a truncated script. Anthropic publishes no signature for it to check.
    installer="$(mktemp)"
    if ! curl -fsSL -o "${installer}" https://claude.ai/install.sh; then
        rm -f -- "${installer}"
        die "could not download the Claude Code installer"
    fi
    bash "${installer}" || { rm -f -- "${installer}"; die "the Claude Code installer failed"; }
    rm -f -- "${installer}"
}

step_install() {
    require_linux
    require_user "${AGENT_USER}" install
    use_local_bin
    umask 077
    install_node
    npm config set prefix "${HOME}/.local"
    log "installing obsidian-headless ${OB_VERSION}"
    npm install -g "obsidian-headless@${OB_VERSION}" >/dev/null
    if command -v claude >/dev/null 2>&1; then
        log "Claude Code $(claude --version) installed (it updates itself)"
    else
        log "installing Claude Code"
        install_claude
    fi
    if [[ ! -f "${RO_KEY}" ]]; then
        log "creating read-only vault key"
        ssh-keygen -q -t ed25519 -N "" -C "${AGENT_USER}@$(hostname) vault read-only" -f "${RO_KEY}"
    fi
    log "done. Next, as pi: ph-agent-setup authorize"
}

# ---- authorize: as pi --------------------------------------------------------

# Prints the base64 blob of the single ed25519 public key in ${1}, or fails. The input is
# agent-controlled, so it is never echoed and only the blob survives: no options, no comment.
parse_agent_key() {
    local raw="${1}" type="" blob="" tmp fingerprint
    [[ "${raw}" != *$'\n'* && "${raw}" != *$'\r'* ]] || return 1
    read -r type blob _ <<< "${raw}" || true
    [[ "${type}" == "ssh-ed25519" && "${blob}" =~ ^[A-Za-z0-9+/]+={0,2}$ ]] || return 1
    tmp="$(mktemp)"
    printf 'ssh-ed25519 %s\n' "${blob}" > "${tmp}"
    fingerprint="$(ssh-keygen -l -f "${tmp}" 2>/dev/null || true)"
    rm -f -- "${tmp}"
    [[ "${fingerprint}" == *"(ED25519)" ]] || return 1
    printf '%s\n' "${blob}"
}

step_authorize() {
    require_not_user "${AGENT_USER}" authorize
    local raw blob line keys="${HOME}/.ssh/authorized_keys"
    # The key comes on stdin (ssh agent@host cat .ssh/vault_ro.pub | ph-agent-setup authorize)
    # or, without it, read as agent, since agent's home is closed to pi. Reading as agent
    # rather than root keeps a planted symlink from exposing root-only files.
    if [[ -t 0 ]]; then
        raw="$(sudo -u "${AGENT_USER}" cat -- "${AGENT_HOME}/.ssh/vault_ro.pub")" \
            || die "no key yet; run 'install' as ${AGENT_USER} first"
    else
        raw="$(head -c 4096)"
    fi
    blob="$(parse_agent_key "${raw}")" || die "not an ed25519 public key (expected one 'ssh-ed25519 KEY' line)"
    # Fetch only: upload-pack serves clones and fetches and never accepts a push.
    line="restrict,command=\"git upload-pack '${VAULT_REPO}'\" ssh-ed25519 ${blob} agent-vault-ro"
    if [[ -f "${keys}" ]] && awk -v b="${blob}" '{ for (i = 1; i <= NF; i++) if ($i == b) f = 1 } END { exit !f }' "${keys}"; then
        log "agent key already authorized"
    else
        printf '%s\n' "${line}" >> "${keys}"
        log "authorized agent key for fetch-only access to ${VAULT_REPO}"
    fi
    # Lets agent fetch just .scripts/ instead of every attachment. The forced command drops
    # GIT_PROTOCOL, so git speaks protocol v0, where fetching the filtered-out files on demand
    # needs allowReachableSHA1InWant.
    git -C "${HOME}/${VAULT_REPO}" config uploadpack.allowFilter true
    git -C "${HOME}/${VAULT_REPO}" config uploadpack.allowReachableSHA1InWant true
    log "done. Next, as ${AGENT_USER}: ph-agent-setup link"
}

# ---- link: as agent (interactive) -------------------------------------------

write_ssh_config() {
    local cfg="${HOME}/.ssh/config"
    if ! grep -q '^Host vault-ro$' "${cfg}" 2>/dev/null; then
        cat >> "${cfg}" <<EOF
Host vault-ro
  HostName localhost
  User ${ADMIN_USER}
  IdentityFile ${RO_KEY}
  IdentitiesOnly yes
EOF
        chmod 600 "${cfg}"
    fi
}

step_link() {
    require_linux
    require_user "${AGENT_USER}" link
    use_local_bin
    umask 077

    if ! ob sync-list-remote >/dev/null 2>&1; then
        log "sign in to Obsidian (your account; typed by you)"
        ob login
    fi
    if ! ob sync-status --path "${VAULT_DIR}" >/dev/null 2>&1; then
        log "linking ${VAULT_DIR} to the remote vault '${VAULT_NAME}'"
        mkdir -p "${VAULT_DIR}"
        ob sync-setup --vault "${VAULT_NAME}" --path "${VAULT_DIR}" --device-name "${DEVICE_NAME}"
    fi
    # Notes and every attachment type; no .obsidian settings, so this box never changes the Mac's or phone's.
    ob sync-config --path "${VAULT_DIR}" --configs "" --file-types image,audio,video,pdf,unsupported \
        --excluded-folders "" --conflict-strategy merge --mode bidirectional --device-name "${DEVICE_NAME}"
    log "first sync (large vaults take a while)"
    ob sync --path "${VAULT_DIR}"

    write_ssh_config
    if [[ ! -d "${TOOLS_DIR}/.git" ]]; then
        log "checking out .scripts/ read-only from the vault repo"
        ssh-keyscan -H localhost >> "${HOME}/.ssh/known_hosts" 2>/dev/null
        git clone --quiet --depth 1 --filter=blob:none --sparse "vault-ro:${VAULT_REPO}" "${TOOLS_DIR}"
        git -C "${TOOLS_DIR}" sparse-checkout set .scripts
    else
        update_tools || log "could not update vault-lint; using the current copy"
    fi
    [[ -x "${BIN_DIR}/vault-lint" ]] || die "no ${BIN_DIR}/vault-lint; run 'ph-agent-setup user' as ${ADMIN_USER}"

    if ! claude auth status >/dev/null 2>&1; then
        log "Claude Code is not signed in: run 'claude' once and log in, then re-run 'link'"
        return 1
    fi
    log "done. Next: ph-agent-setup schedule"
}

# ---- schedule: as agent ------------------------------------------------------

step_schedule() {
    require_user "${AGENT_USER}" schedule
    mkdir -p "${STATE_DIR}"
    local entry current
    entry="${CRON_SCHEDULE} ${BIN_DIR}/ph-agent-setup import >> ${STATE_DIR}/cron.log 2>&1 ${CRON_TAG}"
    current="$(crontab -l 2>/dev/null || true)"
    { printf '%s\n' "${current}" | grep -vF "${CRON_TAG}" || true; printf '%s\n' "${entry}"; } \
        | sed '/^$/d' | crontab -
    log "cron: ${entry}"
}

# ---- lint and mv: the import's helpers, as agent -----------------------------

# TOOLS_DIR is a depth-1 clone: a pull can't merge the next commit into it (no shared history),
# so fetch the newest commit and move to it. Nothing in it is edited by hand.
update_tools() {
    git -C "${TOOLS_DIR}" fetch --quiet --depth 1 origin \
        && git -C "${TOOLS_DIR}" reset --quiet --hard FETCH_HEAD
}

# vault-lint runs python3 from TOOLS_DIR, an agent-owned clone. The import must never be able
# to write there (see the deny rules in write_claude_settings), or it could replace the linter
# it is allowed to run with anything, including network access.
step_lint() {
    exec python3 "${TOOLS_DIR}/.scripts/vault-lint" --root "${VAULT_DIR}" "$@"
}

# Accepts a resolved absolute path inside the resolved vault root, outside the folders that
# configure Obsidian or Claude.
vault_path_ok() {
    local path="${1}" root="${2}" rel
    [[ "${path}" == "${root}/"* ]] || return 1
    rel="/${path#"${root}"/}/"
    case "${rel}" in
        */./*|*/../*|//|*/.obsidian/*|*/.claude/*|*/.git/*|*/.mcp.json/*) return 1 ;;
    esac
}

# The import's only way to move or copy a file: both ends resolve inside the vault, the source
# is a regular file (not a link), the destination folder already exists, and nothing is
# overwritten. VERB is mv or cp.
vault_transfer() {
    local verb="${1}" src dest root src_path dest_dir dest_name dest_path
    shift
    require_user "${AGENT_USER}" "${verb}"
    [[ $# -eq 2 ]] || die "usage: vault-${verb} SRC DEST"
    src="${1}"
    dest="${2}"
    root="$(CDPATH='' cd -P -- "${VAULT_DIR}" && pwd -P)" || die "no vault at ${VAULT_DIR}"
    [[ -f "${src}" && ! -L "${src}" ]] || die "not a regular file: ${src}"
    src_path="$(CDPATH='' cd -P -- "$(dirname -- "${src}")" && pwd -P)/$(basename -- "${src}")"
    if [[ -d "${dest}" && ! -L "${dest}" ]]; then
        dest_dir="${dest}"
        dest_name="$(basename -- "${src}")"
    else
        dest_dir="$(dirname -- "${dest}")"
        dest_name="$(basename -- "${dest}")"
    fi
    dest_dir="$(CDPATH='' cd -P -- "${dest_dir}" 2>/dev/null && pwd -P)" \
        || die "no folder for ${dest}; create it with mkdir -p first"
    dest_path="${dest_dir}/${dest_name}"
    vault_path_ok "${src_path}" "${root}" || die "source is outside the vault: ${src}"
    vault_path_ok "${dest_path}" "${root}" || die "destination is outside the vault: ${dest}"
    [[ ! -e "${dest_path}" && ! -L "${dest_path}" ]] || die "destination exists: ${dest}"
    if [[ "${verb}" == mv ]]; then
        mv -n -- "${src_path}" "${dest_path}"
        [[ ! -e "${src_path}" && -f "${dest_path}" ]] || die "could not move ${src} to ${dest}"
    else
        cp -n -- "${src_path}" "${dest_path}"
        cmp -s -- "${src_path}" "${dest_path}" || die "could not copy ${src} to ${dest}"
    fi
}

step_move() { vault_transfer mv "$@"; }
step_copy() { vault_transfer cp "$@"; }

# ---- import: as agent (cron) -------------------------------------------------

# Prints an absolute path for use inside a permission rule, or fails when it has characters
# that JSON or the rule's glob syntax would treat specially.
rule_path() {
    [[ "${1}" =~ ^/[A-Za-z0-9._/-]+$ ]] || die "unsupported characters in path: ${1}"
    printf '%s\n' "${1%/}"
}

write_claude_settings() {
    local vault home tools
    vault="$(rule_path "${VAULT_DIR}")"
    home="$(rule_path "${HOME}")"
    tools="$(rule_path "${TOOLS_DIR}")"
    mkdir -p "${CONFIG_DIR}"
    # Allowlist for unattended runs: reading anywhere, writing only inside the vault, and the few
    # shell commands an import needs; dontAsk refuses everything else. "//" starts an absolute
    # path in a rule. The denies cover what would let a prompt-injected run outlast itself:
    # ~/.local (node, claude, TOOLS_DIR), ~/.ssh, Claude's settings, and cron's state.
    # Claude talks to Anthropic, and vault-lint is python3 from TOOLS_DIR, which can reach the
    # network, so TOOLS_DIR must stay unwritable here. No cp or mv: they write anywhere agent can;
    # vault-mv and vault-cp move and copy within the vault. No find: -exec/-fprintf run anything past the deny rules
    # below; Glob covers discovery.
    cat > "${CONFIG_DIR}/claude-settings.json" <<EOF
{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep",
      "Write(/${vault}/**)", "Edit(/${vault}/**)",
      "Bash(vault-lint *)", "Bash(vault-lint)", "Bash(vault-mv *)", "Bash(vault-cp *)",
      "Bash(ls *)", "Bash(stat *)", "Bash(file *)", "Bash(wc *)",
      "Bash(grep *)", "Bash(head *)", "Bash(tail *)", "Bash(date *)", "Bash(date)",
      "Bash(mkdir *)", "Bash(cmp *)", "Bash(sha256sum *)"
    ],
    "deny": [
      "WebFetch", "WebSearch",
      "Write(/${home}/.local/**)", "Edit(/${home}/.local/**)",
      "Write(/${home}/.ssh/**)", "Edit(/${home}/.ssh/**)",
      "Write(/${home}/.claude/**)", "Edit(/${home}/.claude/**)",
      "Write(/${home}/.claude.json)", "Edit(/${home}/.claude.json)",
      "Write(/${home}/.config/**)", "Edit(/${home}/.config/**)",
      "Write(/${tools}/**)", "Edit(/${tools}/**)",
      "Write(**/.claude/**)", "Edit(**/.claude/**)",
      "Write(/${vault}/.mcp.json)", "Edit(/${vault}/.mcp.json)",
      "Bash(curl *)", "Bash(wget *)", "Bash(ssh *)", "Bash(scp *)", "Bash(git *)",
      "Bash(cp *)", "Bash(mv *)", "Bash(rm *)", "Bash(sudo *)", "Bash(ob *)"
    ]
  }
}
EOF
}

import_prompt() {
    cat <<EOF
You are the intake file importer for Bran's Obsidian vault at ${VAULT_DIR}, on the Pi-hole box as the locked-down '${AGENT_USER}' user, in an unattended daily run.

Read AGENTS.md and work as the intake file importer (Agents/roles/role-intake-file-importer.md) on all of _imports/ (foreign files) and _captures/ (capture notes), following the manual exactly, from the lint baseline to the run log.

On this machine: wherever the manual says \`python3 .scripts/vault-lint ...\`, run \`vault-lint ...\` (.scripts/ isn't synced here). Move with \`vault-mv SRC DEST\` and copy with \`vault-cp SRC DEST\`: both paths inside the vault, DEST's folder created first with \`mkdir -p\`, never overwriting. There is no cp, mv, rm, or git, and no network.

Nobody is watching, so:
- Don't ask. When something needs Bran (an ambiguous destination or meaning), make the safest choice the manual allows, usually leaving the file where it is or creating an inbox task, and list it under "Decisions for Bran".
- Nothing leaves the vault, nothing is deleted, nothing is committed.

Reply with: files in, Resources and People created or updated, tasks created, files left in _imports/ or _captures/ and why, and the decisions for Bran.
EOF
}

# Files waiting in one drop folder (default _imports), not counting its top-level .gitkeep or any .DS_Store.
drop_count() {
    local dir="${VAULT_DIR}/${1:-_imports}"
    find "${dir}" -type f ! -path "${dir}/.gitkeep" ! -name .DS_Store 2>/dev/null | wc -l | tr -d ' '
}

# Files waiting in both drop folders: _imports/ (foreign files) and _captures/ (capture notes).
pending_count() {
    echo $(( $(drop_count _imports) + $(drop_count _captures) ))
}

step_import() {
    require_linux
    switch_to_agent import
    require_user "${AGENT_USER}" import
    use_local_bin
    umask 077
    mkdir -p "${STATE_DIR}"
    exec 9>"${STATE_DIR}/lock"
    flock -n 9 || die "another import is running"

    log "$(date '+%F %T') sync down"
    ob sync --path "${VAULT_DIR}"
    update_tools || log "could not update vault-lint; using the current copy"

    local count
    count="$(pending_count)"
    if [[ "${count}" -eq 0 ]]; then
        log "imports and captures empty"
        return 0
    fi
    [[ -x "${BIN_DIR}/vault-lint" && -x "${BIN_DIR}/vault-mv" && -x "${BIN_DIR}/vault-cp" ]] \
        || die "no ${BIN_DIR}/vault-lint, vault-mv, or vault-cp; run 'ph-agent-setup user' as ${ADMIN_USER}"
    log "importing ${count} file(s)"
    write_claude_settings
    local status=0
    (cd "${VAULT_DIR}" && claude -p "$(import_prompt)" \
        --permission-mode dontAsk --settings "${CONFIG_DIR}/claude-settings.json") \
        > "${STATE_DIR}/last-run.txt" 2>&1 || status=$?
    cat "${STATE_DIR}/last-run.txt"
    log "sync up"
    ob sync --path "${VAULT_DIR}"
    log "$(date '+%F %T') done (claude exit ${status}); ${count} in, $(pending_count) left in _imports/ and _captures/"
    return "${status}"
}

# ---- status ------------------------------------------------------------------

# Run as the admin user, sync, import, and status switch to agent through the root-owned
# copy, since agent can't read pi's.
switch_to_agent() {
    local step="${1}"
    if [[ "$(id -un)" == "${ADMIN_USER}" ]]; then
        exec sudo -iu "${AGENT_USER}" "${BIN_DIR}/ph-agent-setup" "${step}"
    fi
}

# Sync the vault now instead of waiting for the next import, then show status.
step_sync() {
    require_linux
    switch_to_agent sync
    require_user "${AGENT_USER}" sync
    use_local_bin
    umask 077
    mkdir -p "${STATE_DIR}"
    exec 9>"${STATE_DIR}/lock"
    flock -n 9 || die "an import is running; try again when it finishes"
    log "sync"
    ob sync --path "${VAULT_DIR}"
    step_status
}

step_status() {
    switch_to_agent status
    use_local_bin
    printf 'user      %s\n' "$(id -un)"
    printf 'node      %s\n' "$(node -v 2>/dev/null || echo missing)"
    printf 'ob        %s\n' "$(ob --version 2>/dev/null || echo missing)"
    printf 'claude    %s\n' "$(claude --version 2>/dev/null || echo missing)"
    printf 'vault     %s\n' "$([[ -d "${VAULT_DIR}" ]] && echo "${VAULT_DIR}" || echo 'not linked')"
    printf 'lint      %s\n' "$([[ -f "${TOOLS_DIR}/.scripts/vault-lint" ]] && echo ok || echo missing)"
    printf 'imports   %s file(s)\n' "$(drop_count _imports)"
    printf 'captures  %s file(s)\n' "$(drop_count _captures)"
    printf 'cron      %s\n' "$(crontab -l 2>/dev/null | grep -F "${CRON_TAG}" || echo none)"
}

main() {
    [[ $# -ge 1 ]] || { usage >&2; exit 2; }
    case "${1}" in
        lint) shift; step_lint "$@"; return ;;
        mv) shift; step_move "$@"; return ;;
        cp) shift; step_copy "$@"; return ;;
    esac
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    case "${1}" in
        -h|--help) usage ;;
        user) require_linux; step_user ;;
        install) step_install ;;
        authorize) require_linux; step_authorize ;;
        link) step_link ;;
        schedule) step_schedule ;;
        import) step_import ;;
        status) step_status ;;
        sync) step_sync ;;
        *) printf 'ph-agent-setup: unknown command: %s\n' "${1}" >&2; usage >&2; exit 2 ;;
    esac
}

main "$@"
