#!/usr/bin/env bash
# Review files in the home directory and pick leftovers to archive. With no
# arguments it runs file-review.sh --cleanup; any arguments go to it as they are.

set -euo pipefail

# The script lives at <repo>/stow/tools/.local/bin/df-file-review, reached through its stow link.
repo="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../.." && pwd)"
if [[ ! -f "${repo}/scripts/file-review.sh" ]]; then
    printf 'df-file-review: cannot find scripts/file-review.sh in %s\n' "${repo}" >&2
    exit 1
fi
if [[ $# -eq 0 ]]; then
    set -- --cleanup
fi
exec bash "${repo}/scripts/file-review.sh" "$@"
