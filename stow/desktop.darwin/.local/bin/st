#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["iterm2"]
# ///
"""Open Claude Code in a new iTerm2 window: a whole team, or one directory.

  st TEAM             one tab per agent in TEAM
  st AGENT            one agent from any team, in its own window
  st TEAM/AGENT       the same, when two teams have an agent of that name
  st DIR              Claude Code in DIR
  st                  Claude Code in the current directory
  st --list           list the teams
  st who              list the agents configured for the current directory
  st conf             open the teams file in VS Code
  st TEAM --dry-run   print what would run, open nothing

Teams live in $CLAUDE_TEAM_CONFIG (default ~/.config/claude-team/teams.toml),
a local file: copy ~/.config/claude-team/teams.toml.example to start one.
A team name wins over an agent name, and both win over a directory.
"""

import argparse
import os
import shlex
import sys
import tomllib
from pathlib import Path

CONFIG = Path(
    os.environ.get("CLAUDE_TEAM_CONFIG", "~/.config/claude-team/teams.toml")
).expanduser()

def die(message):
    sys.exit(f"st: {message}")


def no_teams_file():
    die(f"no teams file at {CONFIG}; copy ~/.config/claude-team/teams.toml.example there")


def load_teams():
    if not CONFIG.exists():
        no_teams_file()
    with CONFIG.open("rb") as f:
        return tomllib.load(f)


def team_agents(team_name, team):
    """Return {agent name: settings}: the team's sub-tables, or the team itself as one agent."""
    return {k: v for k, v in team.items() if isinstance(v, dict)} or {team_name: {}}


def agent_commands(team_name, team, only=None):
    """Yield (tab title, shell command) for each agent in the team, or just `only`."""
    team_dir = team.get("dir", os.getcwd())
    for name, agent in team_agents(team_name, team).items():
        if only is not None and name != only:
            continue
        work_dir = Path(agent.get("dir", team_dir)).expanduser()
        argv = [agent.get("command", team.get("command", "claude"))]
        argv += agent.get("args", team.get("args", []))
        prompt = agent.get("prompt", team.get("prompt"))
        if prompt:
            argv.append(prompt)
        yield name, f"cd {shlex.quote(str(work_dir))} && {shlex.join(argv)}"


def find_agent(teams, target):
    """Return (team name, agent name) for AGENT or TEAM/AGENT, or None."""
    team_name, _, agent_name = target.rpartition("/")
    if team_name:
        if team_name in teams and agent_name in team_agents(team_name, teams[team_name]):
            return team_name, agent_name
        return None
    owners = [
        name
        for name, team in teams.items()
        if target in team_agents(name, team)
    ]
    if len(owners) > 1:
        choices = ", ".join(f"{owner}/{target}" for owner in owners)
        die(f"agent {target!r} is in more than one team; pick one: {choices}")
    return (owners[0], target) if owners else None


def tab_command(command):
    """Run command in a login shell as the tab's own program, then stay in a shell.

    Typing it into a fresh tab races the shell's startup and garbles the text.
    """
    shell = os.environ.get("SHELL", "/bin/zsh")
    return shlex.join([shell, "-lic", f"{command}; exec {shlex.quote(shell)} -il"])


async def open_team(connection, commands):
    import iterm2

    await iterm2.async_get_app(connection)  # tab creation needs the app loaded
    window = None
    for title, command in commands:
        if window is None:
            window = await iterm2.Window.async_create(
                connection, command=tab_command(command)
            )
            tab = window.current_tab
        else:
            tab = await window.async_create_tab(command=tab_command(command))
        await tab.async_set_title(title)


def main():
    parser = argparse.ArgumentParser(
        prog="st",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--list", action="store_true", help="list the teams")
    parser.add_argument("--dry-run", action="store_true", help="print, don't open")
    parser.add_argument(
        "target", nargs="?", default=".", help="a team, an agent, or a directory"
    )
    args = parser.parse_args()

    if args.list:
        for name, team in load_teams().items():
            agents = ", ".join(team_agents(name, team))
            print(f"{name:<14} {team.get('dir', '.'):<20} {agents}")
        return

    if args.target == "conf":
        os.execvp("code", ["code", str(CONFIG)])

    teams = load_teams() if CONFIG.exists() else {}
    if args.target == "who":
        cwd = Path.cwd().resolve()
        for team_name, team in teams.items():
            for name, agent in team_agents(team_name, team).items():
                agent_dir = Path(agent.get("dir", team.get("dir", "."))).expanduser()
                if agent_dir.resolve() == cwd:
                    [(_, command)] = agent_commands(team_name, team, name)
                    print(f"{team_name}/{name:<8} {command.partition(' && ')[2]}")
        return
    if args.target in teams:
        commands = list(agent_commands(args.target, teams[args.target]))
    elif found := find_agent(teams, args.target):
        team_name, agent_name = found
        commands = list(agent_commands(team_name, teams[team_name], agent_name))
    elif Path(args.target).expanduser().is_dir():
        # A directory is a team of one: Claude Code there, in its own tab.
        work_dir = Path(args.target).expanduser().resolve()
        commands = [(work_dir.name, f"cd {shlex.quote(str(work_dir))} && claude")]
    elif not CONFIG.exists():
        no_teams_file()
    else:
        die(f"no team, agent, or directory {args.target!r} (teams: {', '.join(teams) or 'none'})")

    if args.dry_run:
        for title, command in commands:
            print(f"[{title}] {command}")
        return

    import iterm2

    iterm2.run_until_complete(lambda connection: open_team(connection, commands))


if __name__ == "__main__":
    main()
