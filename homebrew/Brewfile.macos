# Optional dependencies. `homebrew/brew.sh` prompts for each entry.
# Supported entry types: brew, cask, tap, mas.

# Core
brew "htop"
brew "tree"
brew "wget"

# AI Apps
cask "chatgpt"
cask "claude"

# Browsers
brew "agent-browser"
cask "brave-browser"
cask "comet"
cask "firefox"
cask "google-chrome"
cask "helium-browser"

# Development Tools
brew "colima"
brew "docker"
brew "docker-compose"
brew "docker-credential-helper"
brew "mactop"
cask "cmux"
cask "ghostty"
cask "github"
cask "visual-studio-code"
cask "yaak"

# Productivity
cask "appcleaner"
cask "homebrew-app"
cask "obsidian"
cask "utm"

# Security and Networking
cask "1password"
cask "protonvpn"
cask "tailscale-app"
